@using CleanMadeira.Web.ViewModels
@model CreateUserVM

@{
    ViewData["Title"] = "Novo Utilizador";
}

<div class="card shadow-sm">

    <div class="card-header">

        <h3>Novo Utilizador</h3>

    </div>

    <div class="card-body">

        <form asp-action="Create">

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="PrimeiroNome"
                           class="form-label">
                    </label>

                    <input asp-for="PrimeiroNome"
                           class="form-control" />

                </div>

                <div class="col-md-6 mb-3">

                    <label asp-for="UltimoNome"
                           class="form-label">
                    </label>

                    <input asp-for="UltimoNome"
                           class="form-control" />

                </div>

            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Telemovel"
                       class="form-label">
                </label>

                <input asp-for="Telemovel"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Role"
                       class="form-label">
                </label>

                <select asp-for="Role"
                        class="form-select">

                    <option value="1">
                        Administrador
                    </option>

                    <option value="2">
                        Supervisor
                    </option>

                    <option value="3">
                        Funcionária
                    </option>

                </select>

            </div>

            <div class="mb-4">

                <label asp-for="Password"
                       class="form-label">
                </label>

                <input asp-for="Password"
                       type="password"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-primary">

                Guardar

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancelar

            </a>

        </form>

    </div>

</div>