@using CleanMadeira.Web.ViewModels

@model IEnumerable<UtilizadorVM>

@{
    ViewData["Title"] = "Utilizadores";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Utilizadores</h2>

        <a asp-action="Create"
           class="btn btn-primary">

            Novo Utilizador

        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <table class="table table-hover">

                <thead>

                    <tr>
                        <th>Nome</th>
                        <th>Email</th>
                        <th>Telefone</th>
                        <th>Perfil</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var user in Model)
                    {
                        <tr>

                            <td>
                                @user.PrimeiroNome @user.UltimoNome
                            </td>

                            <td>
                                @user.Email
                            </td>

                            <td>
                                @user.Telemovel
                            </td>

                            <td>
                                @user.Role
                            </td>

                            <td>

                                @if (user.Active)
                                {
                                    <span class="badge bg-success">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inativo
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-warning">

                                    Editar

                                </a>

                                <a asp-action="Details"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-info">

                                    Ver

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>