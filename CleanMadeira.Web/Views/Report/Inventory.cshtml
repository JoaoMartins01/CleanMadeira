@model CleanMadeira.Web.ViewModels.Report.InventoryReportVM

@{
    ViewData["Title"] = "Relatório de Inventário";

    var propertyNames = Model.Items
        .Select(x => x.PropertyName)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>
                Relatório de Inventário
            </h1>

            <p class="text-muted mb-0">
                Estado atual do stock das propriedades
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Report"
               asp-action="ExportInventoryExcel"
               class="btn btn-outline-success">

                <i class="bi bi-file-earmark-excel me-1"></i>
                Excel
            </a>

            <a asp-controller="Report"
               asp-action="ExportInventoryPdf"
               class="btn btn-outline-danger">

                <i class="bi bi-file-earmark-pdf me-1"></i>
                PDF
            </a>

            <a asp-controller="Report"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Voltar
            </a>

        </div>

    </div>


    <!-- RESUMO -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Produtos
                    </div>

                    <div class="h3 fw-bold mb-0">
                        @Model.TotalItems
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Stock baixo
                    </div>

                    <div class="h3 fw-bold text-warning mb-0">
                        @Model.LowStockItems
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Sem stock
                    </div>

                    <div class="h3 fw-bold text-danger mb-0">
                        @Model.OutOfStockItems
                    </div>

                </div>

            </div>

        </div>


        <div class="col-6 col-lg-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="text-muted small mb-1">
                        Propriedades
                    </div>

                    <div class="h3 fw-bold text-primary mb-0">
                        @Model.PropertiesWithInventory
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- FILTROS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3">

                <div class="col-12 col-md-6">

                    <label for="propertyFilter"
                           class="form-label fw-semibold">
                        Propriedade
                    </label>

                    <select id="propertyFilter"
                            class="form-select">

                        <option value="">
                            Todas as propriedades
                        </option>

                        @foreach (var property in propertyNames)
                        {
                            <option value="@property">
                                @property
                            </option>
                        }

                    </select>

                </div>


                <div class="col-12 col-md-6">

                    <label for="stockFilter"
                           class="form-label fw-semibold">
                        Estado do stock
                    </label>

                    <select id="stockFilter"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        <option value="normal">
                            Disponível
                        </option>

                        <option value="low">
                            Stock baixo
                        </option>

                        <option value="out">
                            Sem stock
                        </option>

                    </select>

                </div>

            </div>

        </div>

    </div>


    @if (!Model.Items.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-box-seam display-4 text-muted"></i>

                <h2 class="h5 fw-semibold mt-3">
                    Sem produtos no inventário
                </h2>

                <p class="text-muted mb-0">
                    Ainda não existem produtos registados.
                </p>

            </div>

        </div>
    }
    else
    {
        <!-- =====================================================
             DESKTOP
             ===================================================== -->

        <div class="card border-0 shadow-sm d-none d-md-block">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-3">Produto</th>
                            <th>Propriedade</th>
                            <th>Quantidade</th>
                            <th>Unidade</th>
                            <th>Stock mínimo</th>
                            <th>Estado</th>
                            <th class="text-end pe-3">
                                Ações
                            </th>
                        </tr>

                    </thead>

                    <tbody id="inventoryTableBody">

                        @foreach (var item in Model.Items)
                        {
                            var stockState =
                                item.IsOutOfStock
                                    ? "out"
                                    : item.IsLowStock
                                        ? "low"
                                        : "normal";

                            <tr class="inventory-row"
                                data-property="@item.PropertyName"
                                data-stock="@stockState">

                                <td class="ps-3 fw-semibold">
                                    @item.Name
                                </td>

                                <td>
                                    <i class="bi bi-house-door me-1 text-muted"></i>
                                    @item.PropertyName
                                </td>

                                <td class="fw-semibold">
                                    @item.Quantity
                                </td>

                                <td>
                                    @item.Unit
                                </td>

                                <td>
                                    @item.MinimumQuantity
                                </td>

                                <td>

                                    @if (item.IsOutOfStock)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Sem stock
                                        </span>
                                    }
                                    else if (item.IsLowStock)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            Stock baixo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Disponível
                                        </span>
                                    }

                                </td>

                                <td class="text-end pe-3">

                                    <a asp-controller="Inventory"
                                       asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary"
                                       title="Detalhes">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =====================================================
             MOBILE
             ===================================================== -->

        <div class="d-md-none">

            <div class="d-flex flex-column gap-3"
                 id="inventoryMobileList">

                @foreach (var item in Model.Items)
                {
                    var stockState =
                        item.IsOutOfStock
                            ? "out"
                            : item.IsLowStock
                                ? "low"
                                : "normal";

                    <div class="card border-0 shadow-sm inventory-card"
                         data-property="@item.PropertyName"
                         data-stock="@stockState">

                        <div class="card-body">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-3 mb-3">

                                <div>

                                    <h2 class="h5 fw-bold mb-1">
                                        @item.Name
                                    </h2>

                                    <div class="text-muted small">

                                        <i class="bi bi-house-door me-1"></i>
                                        @item.PropertyName

                                    </div>

                                </div>


                                @if (item.IsOutOfStock)
                                {
                                    <span class="badge
                                        bg-danger-subtle
                                        text-danger
                                        flex-shrink-0">

                                        Sem stock

                                    </span>
                                }
                                else if (item.IsLowStock)
                                {
                                    <span class="badge
                                        bg-warning-subtle
                                        text-warning-emphasis
                                        flex-shrink-0">

                                        Stock baixo

                                    </span>
                                }
                                else
                                {
                                    <span class="badge
                                        bg-success-subtle
                                        text-success
                                        flex-shrink-0">

                                        Disponível

                                    </span>
                                }

                            </div>


                            <div class="row g-2 mb-3">

                                <div class="col-4">

                                    <small class="text-muted d-block">
                                        Quantidade
                                    </small>

                                    <strong>
                                        @item.Quantity
                                    </strong>

                                </div>


                                <div class="col-4">

                                    <small class="text-muted d-block">
                                        Unidade
                                    </small>

                                    <strong>
                                        @item.Unit
                                    </strong>

                                </div>


                                <div class="col-4">

                                    <small class="text-muted d-block">
                                        Mínimo
                                    </small>

                                    <strong>
                                        @item.MinimumQuantity
                                    </strong>

                                </div>

                            </div>


                            <a asp-controller="Inventory"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-primary w-100">

                                <i class="bi bi-eye me-1"></i>
                                Ver produto

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>


@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const propertyFilter =
                document.getElementById("propertyFilter");

            const stockFilter =
                document.getElementById("stockFilter");


            function applyFilters() {

                const property =
                    propertyFilter.value;

                const stock =
                    stockFilter.value;


                document.querySelectorAll(
                    ".inventory-row, .inventory-card"
                )
                    .forEach(element => {

                        const matchesProperty =
                            !property ||
                            element.dataset.property === property;

                        const matchesStock =
                            !stock ||
                            element.dataset.stock === stock;

                        element.style.display =
                            matchesProperty && matchesStock
                                ? ""
                                : "none";

                    });

            }


            propertyFilter.addEventListener(
                "change",
                applyFilters
            );

            stockFilter.addEventListener(
                "change",
                applyFilters
            );

        });
    </script>

}