@{
    ViewData["Title"] = "Relatórios";
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-bar-chart-line me-2"></i>
            Relatórios
        </h1>

        <p class="text-muted mb-0">
            Consulte e exporte os dados da sua atividade.
        </p>
    </div>


    <!-- RELATÓRIOS -->
    <div class="row g-4">

        <!-- LIMPEZAS -->
        <div class="col-12 col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="rounded-3 bg-primary-subtle
                            text-primary
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 48px; height: 48px;">

                            <i class="bi bi-stars fs-4"></i>

                        </div>

                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Limpezas
                            </h2>

                            <span class="text-muted small">
                                Relatório mensal
                            </span>
                        </div>

                    </div>

                    <p class="text-muted">
                        Consulte as limpezas realizadas e agendadas,
                        respetivos estados, prioridades, propriedades
                        e responsáveis.
                    </p>

                    <a asp-controller="Report"
                       asp-action="MonthlyCleanings"
                       class="btn btn-primary">

                        Ver relatório

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- MANUTENÇÕES -->
        <div class="col-12 col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="rounded-3 bg-warning-subtle
                            text-warning-emphasis
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 48px; height: 48px;">

                            <i class="bi bi-tools fs-4"></i>

                        </div>

                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Manutenções
                            </h2>

                            <span class="text-muted small">
                                Relatório mensal
                            </span>
                        </div>

                    </div>

                    <p class="text-muted">
                        Consulte intervenções de manutenção,
                        estados, prioridades, propriedades e
                        responsáveis.
                    </p>

                    <a asp-controller="Report"
                       asp-action="MonthlyMaintenances"
                       class="btn btn-primary">

                        Ver relatório

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- INVENTÁRIO -->
        <div class="col-12 col-md-6 col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="rounded-3 bg-success-subtle
                            text-success
                            d-flex align-items-center
                            justify-content-center me-3"
                             style="width: 48px; height: 48px;">

                            <i class="bi bi-box-seam fs-4"></i>

                        </div>

                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Inventário
                            </h2>

                            <span class="text-muted small">
                                Stock e consumos
                            </span>
                        </div>

                    </div>

                    <p class="text-muted">
                        Consulte o estado do inventário,
                        produtos com stock reduzido e informação
                        por propriedade.
                    </p>

                    <a asp-controller="Report"
                       asp-action="Inventory"
                       class="btn btn-primary">

                        Ver relatório

                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>