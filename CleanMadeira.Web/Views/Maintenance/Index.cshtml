@model IEnumerable<CleanMadeira.Domain.Entities.Maintenance>

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-tools me-2"></i>
                Manutenção
            </h1>

            <p class="text-muted mb-0">
                Pedidos de manutenção das propriedades
            </p>
        </div>

        <a asp-controller="MaintenanceProvider"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-person-workspace"></i>
            Prestadores
        </a>

        <a asp-controller="Maintenance"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Adicionar manutenção
        </a>


    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-box-seam display-4 text-muted"></i>

                <h2 class="h5 fw-semibold mt-3">
                    Ainda não existem manutenções
                </h2>

                <p class="text-muted">
                    Adiciona o primeira manutenção à propriedade.
                </p>

                <a asp-controller="Maintenance"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Adicionar Manutenção
                </a>




            </div>
        </div>
    }
    else
    {
        




                <!-- Desktop e tablet -->
                <div class="table-responsive d-none d-md-block">

            
                
            

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Título</th>
                                <th>Propriedade</th>
                                <th>Prestador</th>
                                <th>Data</th>
                                <th>Prioridade</th>
                                <th>Estado</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var maintenance in Model)
                            {
                        <tr>
                            <td>@maintenance.Title</td>
                            <td>@maintenance.Property.Name</td>
                            <td>@maintenance.MaintenanceProvider?.Name</td>
                            <td>
                                @maintenance.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>@maintenance.Priority</td>
                            <td>@maintenance.Status</td>
                            <td class="text-end">
                                <a asp-controller="Maintenance"
                                   asp-action="Edit"
                                   asp-route-id="@maintenance.Id"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Editar">

                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a asp-controller="Maintenance"
                                   asp-action="Details"
                                   asp-route-id="@maintenance.Id"
                                   class="btn btn-sm btn-outline-secondary"
                                   title="Detalhes">

                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-controller="Maintenance"
                                   asp-action="Delete"
                                   asp-route-id="@maintenance.Id"
                                   class="btn btn-sm btn-outline-danger"
                                   title="Eliminar">

                                   <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <!-- Mobile -->
                <div class="d-md-none p-3">

                    <div class="row g-3">

                        @foreach (var maintenance in Model)
                        {
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                    <div>
                                        <h5 class="mb-1">
                                            @maintenance.Title
                                        </h5>

                                        <span class="text-muted">
                                            @maintenance.Property.Name
                                        </span>
                                    </div>

                                    <span class="badge bg-primary">
                                        @maintenance.Status
                                    </span>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">Data</small>
                                    <div>
                                        @maintenance.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <small class="text-muted">Prestador</small>
                                    <div>
                                        @(maintenance.MaintenanceProvider.Name ?? "Não atribuído")
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <small class="text-muted">Prioridade</small>
                                    <div>
                                        @maintenance.Priority
                                    </div>
                                </div>

                                <div class="d-grid gap-2">
                                    <a asp-action="Details"
                                       asp-route-id="@maintenance.Id"
                                       class="btn btn-primary">
                                        Ver manutenção
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@maintenance.Id"
                                       class="btn btn-outline-secondary">
                                        Editar
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@maintenance.Id"
                                       class="btn btn-outline-danger">
                                        Eliminar
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                        }

                    </div>

                </div>
    }

</div>