@using CleanMadeira.Domain.Enums
@model CleanMadeira.Web.ViewModels.Maintenance.EditMaintenanceVM

@{
    ViewData["Title"] = "Editar Manutenção";
}

<div class="container">

    <div class="row mb-4">
        <div class="col">
            <h2>Editar Manutenção</h2>
            <p class="text-muted">
                Atualize os dados da manutenção selecionada.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <div class="mb-3">
                    <label asp-for="PropriedadeId"
                           class="form-label">
                    </label>

                    <select asp-for="PropriedadeId"
                            asp-items="ViewBag.Propriedades"
                            class="form-select">
                        <option value="">
                            Selecione uma propriedade
                        </option>
                    </select>

                <span asp-validation-for="PropriedadeId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedUserId"
                           class="form-label">
                    </label>

                    <select asp-for="AssignedUserId"
                            asp-items="ViewBag.Prestadores"
                            class="form-select">
                        <option value="">
                            Sem responsável atribuído
                        </option>
                    </select>

                    <span asp-validation-for="AssignedUserId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Title"
                           class="form-label">
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Ex.: Reparar torneira da cozinha" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              rows="5"
                              class="form-control"
                              placeholder="Descreva o problema ou o trabalho necessário"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority"
                               class="form-label">
                        </label>

                        <select asp-for="Priority"
                                asp-items="Html.GetEnumSelectList<MaintenancePriority>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Priority"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status"
                               class="form-label">
                        </label>

                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<MaintenanceStatus>()"
                                class="form-select">
                        </select>

                        <span asp-validation-for="Status"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="mb-4">
                    <label asp-for="ScheduledDate"
                           class="form-label">
                    </label>

                    <input asp-for="ScheduledDate"
                           type="datetime-local"
                           class="form-control"
                           asp-format="{0:yyyy-MM-ddTHH:mm}" />

                    <span asp-validation-for="ScheduledDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancelar
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-primary">
                        Ver detalhes
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar alterações
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
