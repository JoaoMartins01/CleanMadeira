@using CleanMadeira.Domain.Enums
@model CleanMadeira.Web.ViewModels.Maintenance.MaintenanceDetailsVM

@{
    ViewData["Title"] = "Detalhes da Manutenção";

    var description = string.IsNullOrWhiteSpace(Model.Description)
        ? "Sem descrição."
        : Model.Description.Trim();

    var rejectionReason = string.IsNullOrWhiteSpace(Model.RejectionReason)
        ? "Sem motivo."
        : Model.RejectionReason.Trim();

    var providerNotes = string.IsNullOrWhiteSpace(Model.ProviderNotes)
        ? "Sem motivo."
        : Model.ProviderNotes.Trim();

    var priorityClass = Model.Priority switch
    {
        MaintenancePriority.Baixa => "cm-priority-low",
        MaintenancePriority.Media => "cm-priority-normal",
        MaintenancePriority.Alta => "cm-priority-high",
        MaintenancePriority.Urgente => "cm-priority-urgent",
        _ => "cm-status-neutral"
    };

    var priorityIcon = Model.Priority switch
    {
        MaintenancePriority.Baixa => "bi-arrow-down-circle",
        MaintenancePriority.Media => "bi-dash-circle",
        MaintenancePriority.Alta => "bi-arrow-up-circle",
        MaintenancePriority.Urgente => "bi-exclamation-octagon-fill",
        _ => "bi-circle"
    };

    var priorityText = Model.Priority switch
    {
        MaintenancePriority.Media => "Média",
        _ => Model.Priority.ToString()
    };


    var statusClass = Model.Status switch
    {
        MaintenanceStatus.Pendente => "cm-status-pending",
        MaintenanceStatus.Aceite => "cm-status-success",
        MaintenanceStatus.EmProgresso => "cm-status-progress",
        MaintenanceStatus.Completo => "cm-status-success",
        MaintenanceStatus.Cancelado => "cm-status-danger",
        MaintenanceStatus.Rejeitada => "cm-status-danger",
        _ => "cm-status-neutral"
    };

    var statusIcon = Model.Status switch
    {
        MaintenanceStatus.Pendente => "bi-hourglass-split",
        MaintenanceStatus.Aceite => "bi-check-circle",
        MaintenanceStatus.EmProgresso => "bi-play-circle-fill",
        MaintenanceStatus.Completo => "bi-check-circle-fill",
        MaintenanceStatus.Cancelado => "bi-x-circle",
        MaintenanceStatus.Rejeitada => "bi-x-octagon-fill",
        _ => "bi-circle"
    };

    var statusText = Model.Status switch
    {
        MaintenanceStatus.EmProgresso => "Em progresso",
        MaintenanceStatus.Completo => "Concluída",
        _ => Model.Status.ToString()
    };
}

<div class="container-fluid py-4">


    <!-- CABEÇALHO -->
    <div class="cm-page-header">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-tools me-2 text-primary"></i>
                Detalhes da Manutenção
            </h1>

            <p class="text-muted mb-0">
                Informação completa da manutenção
            </p>
        </div>

        <div class="cm-page-header-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">

                <i class="bi bi-pencil me-1"></i>
                Editar
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Voltar
            </a>

        </div>

    </div>


    <div class="row g-4">

        <!-- COLUNA PRINCIPAL -->
        <div class="col-12 col-xl-8">

            <div class="cm-card mb-4">

                <div class="cm-card-header">

                    <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        align-items-md-start
                        gap-3">

                        <div>

                            <div class="text-muted small mb-1">
                                Manutenção
                            </div>

                            <h2 class="h4 fw-bold mb-0">
                                @Model.Title
                            </h2>

                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <span class="cm-badge @priorityClass">

                                <i class="bi @priorityIcon me-1"></i>
                                @priorityText

                            </span>

                            <span class="cm-badge @statusClass">

                                <i class="bi @statusIcon me-1"></i>
                                @statusText

                            </span>

                        </div>

                    </div>

                </div>


                <div class="cm-card-body">

                    <!-- PROPRIEDADE E RESPONSÁVEL -->

                    <div class="row g-3 mb-4">

                        <div class="col-12 col-md-6">

                            <div class="cm-info-box h-100">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="cm-icon-box">
                                        <i class="bi bi-house-door"></i>
                                    </div>

                                    <div>

                                        <div class="text-muted small">
                                            Propriedade
                                        </div>

                                        <div class="fw-semibold">
                                            @Model.PropertyName
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-md-6">

                            <div class="cm-info-box h-100">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="cm-icon-box">
                                        <i class="bi bi-person-workspace"></i>
                                    </div>

                                    <div>

                                        <div class="text-muted small">
                                            Responsável
                                        </div>

                                        <div class="fw-semibold">

                                            @if (string.IsNullOrWhiteSpace(Model.AssignedUserName))
                                            {
                                                <span class="text-muted">
                                                    Não atribuído
                                                </span>
                                            }
                                            else
                                            {
                                                @Model.AssignedUserName
                                            }

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- DATAS -->

                    <div class="row g-3 mb-4">

                        <div class="col-12 col-md-6">

                            <div class="cm-info-box h-100">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="cm-icon-box">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>

                                    <div>

                                        <div class="text-muted small">
                                            Data prevista
                                        </div>

                                        <div class="fw-semibold">
                                            @Model.ScheduledDate.ToLocalTime().ToString("dd/MM/yyyy 'às' HH:mm")
                                            
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="col-12 col-md-6">

                            <div class="cm-info-box h-100">

                                <div class="d-flex align-items-center gap-3">

                                    <div class="cm-icon-box">
                                        <i class="bi bi-clock-history"></i>
                                    </div>

                                    <div>

                                        <div class="text-muted small">
                                            Criado em
                                        </div>

                                        <div class="local-date"
                                             data-format="long-pt" ,
                                             data-date="@DateTime.SpecifyKind(
                                             @Model.CreatedAt,
                                             DateTimeKind.Utc
                                             ).ToString("O")">
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- DESCRIÇÃO -->

                    <div>

                        <div class="d-flex align-items-center gap-2 mb-2">

                            <i class="bi bi-text-paragraph text-primary"></i>

                            <h3 class="h6 fw-bold mb-0">
                                Descrição
                            </h3>

                        </div>

                        <div class="cm-description-box">
                            <span style="white-space: pre-line;">@description</span>
                        </div>

                    </div>


                    <!-- MOTIVO DE REJEIÇÃO -->
                    @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
                    {
                        <div class="mt-4">

                            <div class="d-flex align-items-center gap-2 mb-2">

                                <i class="bi bi-x-octagon-fill text-danger"></i>

                                <h3 class="h6 fw-bold mb-0">
                                    Motivo da rejeição
                                </h3>

                            </div>

                            <div class="cm-rejection-box">
                                <span style="white-space: pre-line;">
                                    @rejectionReason
                                </span>
                            </div>

                        </div>
                    }

                    <!-- Notas do Prestador -->
                    @if (!string.IsNullOrWhiteSpace(Model.ProviderNotes))
                    {
                        <div class="mt-4">

                            <div class="d-flex align-items-center gap-2 mb-2">

                                <i class="bi bi-x-octagon-fill text-danger"></i>

                                <h3 class="h6 fw-bold mb-0">
                                    Notas do prestador
                                </h3>

                            </div>

                            <div class="cm-rejection-box">
                                <span style="white-space: pre-line;">
                                    @providerNotes
                                </span>
                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- COLUNA LATERAL -->
        <div class="col-12 col-xl-4">

            <div class="cm-card">

                <div class="cm-card-header">

                    <h2 class="h5 fw-bold mb-0">
                        <i class="bi bi-info-circle me-2 text-primary"></i>
                        Estado da manutenção
                    </h2>

                </div>

                <div class="cm-card-body">

                    <div class="mb-4">

                        <div class="text-muted small mb-2">
                            Prioridade
                        </div>

                        <span class="cm-badge @priorityClass">

                            <i class="bi @priorityIcon me-1"></i>
                            @priorityText

                        </span>

                    </div>


                    <div class="mb-4">

                        <div class="text-muted small mb-2">
                            Estado atual
                        </div>

                        <span class="cm-badge @statusClass">

                            <i class="bi @statusIcon me-1"></i>
                            @statusText

                        </span>

                    </div>


                    <hr />


                    <div class="d-grid gap-2">

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary">

                            <i class="bi bi-pencil me-1"></i>
                            Editar manutenção
                        </a>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-left me-1"></i>
                            Voltar às manutenções
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>