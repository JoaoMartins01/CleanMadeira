@using CleanMadeira.Domain.Enums
@model CleanMadeira.Web.ViewModels.Maintenance.MaintenanceDetailsVM

@{
    ViewData["Title"] = "Eliminar Manutenção";
}

<div class="container">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-danger">

                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        Eliminar Manutenção
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-warning">
                        <strong>Atenção!</strong>
                        Tem a certeza que pretende eliminar esta manutenção?
                        Esta ação não pode ser desfeita.
                    </div>

                    <dl class="row">

                        <dt class="col-sm-4">
                            Título
                        </dt>

                        <dd class="col-sm-8">
                            @Model.Title
                        </dd>

                        <dt class="col-sm-4">
                            Propriedade
                        </dt>

                        <dd class="col-sm-8">
                            @Model.PropertyName
                        </dd>

                        <dt class="col-sm-4">
                            Responsável
                        </dt>

                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.AssignedUserName)
                                ? "Não atribuído"
                                : Model.AssignedUserName)
                        </dd>

                        <dt class="col-sm-4">
                            Prioridade
                        </dt>

                        <dd class="col-sm-8">

                            @switch (Model.Priority)
                            {
                                case MaintenancePriority.Baixa:
                                    <span class="badge bg-success">Baixa</span>
                                    break;

                                case MaintenancePriority.Media:
                                    <span class="badge bg-warning text-dark">Média</span>
                                    break;

                                case MaintenancePriority.Alta:
                                    <span class="badge bg-danger">Alta</span>
                                    break;

                                case MaintenancePriority.Urgente:
                                    <span class="badge bg-dark">Urgente</span>
                                    break;
                            }

                        </dd>

                        <dt class="col-sm-4">
                            Estado
                        </dt>

                        <dd class="col-sm-8">

                            @switch (Model.Status)
                            {
                                case MaintenanceStatus.Pendente:
                                    <span class="badge bg-secondary">Pendente</span>
                                    break;

                                case MaintenanceStatus.EmProgresso:
                                    <span class="badge bg-primary">Em progresso</span>
                                    break;

                                case MaintenanceStatus.Completo:
                                    <span class="badge bg-success">Concluída</span>
                                    break;

                                case MaintenanceStatus.Cancelado:
                                    <span class="badge bg-danger">Cancelada</span>
                                    break;
                            }

                        </dd>

                        <dt class="col-sm-4">
                            Data Prevista
                        </dt>

                        <dd class="col-sm-8">
                            @Model.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
                        </dd>

                    </dl>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <hr />

                        <h5>Descrição</h5>

                        <div class="border rounded p-3 bg-light">
                            @Model.Description
                        </div>
                    }

                    <hr />

                    <form asp-action="DeleteConfirmed" method="post">

                        <input asp-for="Id" type="hidden" />

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-danger">
                                Eliminar Manutenção
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>