@using CleanMadeira.Web.ViewModels.Empresa
@model EmpresaVM

@{
    ViewData["Title"] = "Nova Empresa";
}

<div class="card">

    <div class="card-header">
        <h3>Nova Empresa</h3>
    </div>

    <div class="card-body">

        <form asp-action="Create">

            <div class="mb-3">

                <label asp-for="Nome"
                       class="form-label">
                </label>

                <input asp-for="Nome"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Nif"
                       class="form-label">
                </label>

                <input asp-for="Nif"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Telefone"
                       class="form-label">
                </label>

                <input asp-for="Telefone"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Endereço"
                       class="form-label">
                </label>

                <input asp-for="Endereço"
                       class="form-control" />

            </div>

            <button type="submit"
                    class="btn btn-primary">

                Guardar

            </button>

        </form>

    </div>

</div>