@using CleanMadeira.Web.ViewModels.Empresa
@model EmpresaVM

@{
    ViewData["Title"] = "Editar Empresa";
}

<div class="card">

    <div class="card-header">
        <h3>Editar Empresa</h3>
    </div>

    <div class="card-body">

        <form asp-action="Edit">

            <input asp-for="Id" type="hidden" />

            <div class="mb-3">

                <label asp-for="Nome"></label>

                <input asp-for="Nome"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Nif"></label>

                <input asp-for="Nif"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Email"></label>

                <input asp-for="Email"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Telefone"></label>

                <input asp-for="Telefone"
                       class="form-control" />

            </div>

            <div class="mb-3">

                <label asp-for="Endereço"></label>

                <input asp-for="Endereço"
                       class="form-control" />

            </div>

            <div class="form-check mb-3">

                <input asp-for="Active"
                       class="form-check-input" />

                <label asp-for="Active"
                       class="form-check-label">
                </label>

            </div>

            <button type="submit"
                    class="btn btn-success">

                Atualizar

            </button>

        </form>

    </div>

</div>