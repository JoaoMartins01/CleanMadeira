@using CleanMadeira.Domain.Enums
@model IEnumerable<CleanMadeira.Domain.Entities.MaintenanceReport>

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Reportes de Manutenção
            </h1>

            <p class="text-muted mb-0">
                Problemas reportados pelos limpadores.
            </p>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-clipboard-x display-4 text-muted"></i>

                <h2 class="h5 mt-3">
                    Não existem reportes.
                </h2>

                <p class="text-muted">
                    Quando um limpador reportar um problema,
                    aparecerá aqui.
                </p>

            </div>

        </div>
    }
    else
    {

        <div class="table-responsive d-none d-md-block">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Título</th>
                        <th>Propriedade</th>
                        <th>Reportado por</th>
                        <th>Data</th>
                        <th>Prioridade</th>
                        <th>Estado</th>
                        <th class="text-end">
                            Ações
                        </th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var report in Model)
                    {
                        <tr>

                            <td>
                                @report.Title
                            </td>

                            <td>
                                @report.Property.Name
                            </td>

                            <td>
                                @report.ReportedByUser.PrimeiroNome
                                @report.ReportedByUser.UltimoNome
                            </td>

                            <td>
                                @report.ReportedAt;
                            </td>

                            <td>

                                @switch (report.Priority)
                                {
                                    case MaintenancePriority.Baixa:

                                        <span class="badge bg-success">
                                            Baixa
                                        </span>

                                        break;

                                    case MaintenancePriority.Media:

                                        <span class="badge bg-primary">
                                            Normal
                                        </span>

                                        break;

                                    case MaintenancePriority.Alta:

                                        <span class="badge bg-warning text-dark">
                                            Alta
                                        </span>

                                        break;

                                    default:

                                        <span class="badge bg-danger">
                                            Urgente
                                        </span>

                                        break;
                                }

                            </td>

                            <td>

                                @switch (report.Status)
                                {
                                    case MaintenanceReportStatus.PendingReview:

                                        <span class="badge bg-warning text-dark">
                                            Pendente
                                        </span>

                                        break;

                                    case MaintenanceReportStatus.ConvertedToMaintenance:

                                        <span class="badge bg-success">
                                            Convertido
                                        </span>

                                        break;

                                    case MaintenanceReportStatus.ResolvedWithoutMaintenance:

                                        <span class="badge bg-info">
                                            Resolvido
                                        </span>

                                        break;

                                    default:

                                        <span class="badge bg-secondary">
                                            Rejeitado
                                        </span>

                                        break;
                                }

                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@report.Id"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="bi bi-eye"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Mobile -->
        <!-- Mobile -->
        <div class="d-md-none">

            <div class="row g-3">

                @foreach (var report in Model)
                {
                    <div class="col-12">

                        <div class="card app-card report-mobile-card">

                            <div class="card-body p-3">

                                <div class="d-flex
                                    justify-content-between
                                    align-items-start
                                    gap-3 mb-3">

                                    <div class="flex-grow-1">

                                        <h2 class="h6 fw-bold mb-1">
                                            @report.Title
                                        </h2>

                                        <div class="text-muted small">
                                            <i class="bi bi-house-door me-1"></i>
                                            @(report.Property?.Name ?? "Propriedade indisponível")
                                        </div>

                                    </div>

                                    @switch (report.Status)
                                    {
                                        case MaintenanceReportStatus.PendingReview:
                                            <span class="badge bg-warning text-dark">
                                                Pendente
                                            </span>
                                            break;

                                        case MaintenanceReportStatus.ConvertedToMaintenance:
                                            <span class="badge bg-success">
                                                Convertido
                                            </span>
                                            break;

                                        case MaintenanceReportStatus.ResolvedWithoutMaintenance:
                                            <span class="badge bg-info text-dark">
                                                Resolvido
                                            </span>
                                            break;

                                        case MaintenanceReportStatus.Rejected:
                                            <span class="badge bg-secondary">
                                                Rejeitado
                                            </span>
                                            break;
                                    }

                                </div>

                                <div class="report-mobile-info">

                                    <div>
                                        <span class="report-mobile-label">
                                            <i class="bi bi-person me-1"></i>
                                            Reportado por
                                        </span>

                                        <strong>
                                            @if (report.ReportedByUser != null)
                                            {
                                                @($"{report.ReportedByUser.PrimeiroNome} {report.ReportedByUser.UltimoNome}")
                                            }
                                            else
                                            {
                                                <span>Não disponível</span>
                                            }
                                        </strong>
                                    </div>

                                    <div>
                                        <span class="report-mobile-label">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            Data
                                        </span>

                                        <strong>
                                            @report.ReportedAt.ToString("dd/MM/yyyy HH:mm")
                                            
                                        </strong>
                                    </div>

                                    <div>
                                        <span class="report-mobile-label">
                                            <i class="bi bi-flag me-1"></i>
                                            Prioridade
                                        </span>

                                        <div>
                                            @switch (report.Priority)
                                            {
                                                case MaintenancePriority.Baixa:
                                                    <span class="badge bg-success">
                                                        Baixa
                                                    </span>
                                                    break;

                                                case MaintenancePriority.Media:
                                                    <span class="badge bg-primary">
                                                        Normal
                                                    </span>
                                                    break;

                                                case MaintenancePriority.Alta:
                                                    <span class="badge bg-warning text-dark">
                                                        Alta
                                                    </span>
                                                    break;

                                                case MaintenancePriority.Urgente:
                                                    <span class="badge bg-danger">
                                                        Urgente
                                                    </span>
                                                    break;
                                            }
                                        </div>
                                    </div>

                                </div>

                                <div class="d-grid mt-3">

                                    <a asp-controller="MaintenanceReport"
                                       asp-action="Details"
                                       asp-route-id="@report.Id"
                                       class="btn btn-outline-primary">

                                        <i class="bi bi-eye me-1"></i>
                                        Ver reporte
                                    </a>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    }

</div>