@model IEnumerable<CleanMadeira.Web.ViewModels.Propriedade.PropriedadeVM>

@{
    ViewData["Title"] = "Propriedades Desativadas";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>
            <i class="bi bi-archive-fill me-2"></i>
            Propriedades Desativadas
        </h2>

        <a asp-action="Index" class="btn btn-primary">
            <i class="bi bi-arrow-left me-1"></i>
            Voltar às Propriedades
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle-fill me-2"></i>
            Não existem propriedades desativadas.
        </div>
    }
    else
    {
        

            

                <table class="table table-hover align-middle mb-0">

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <div class="col-12 col-md-6 col-xl-4">
                                <div class="card border-0 shadow-sm h-100">
                                    <div class="card-body">
                                        <h5 class="fw-bold">@item.Nome</h5>

                                        <p class="text-muted mb-2">
                                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                            @item.Endereco
                                        </p>

                                        <p class="text-muted">
                                            <i class="bi bi-map-fill text-success me-1"></i>
                                            @item.Freguesia
                                        </p>

                                        <a asp-action="Restore"
                                           asp-route-id="@item.Id"
                                           class="btn btn-success w-100">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                                            Reativar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }

                    </tbody>

                </table>

            

        
    }

</div>