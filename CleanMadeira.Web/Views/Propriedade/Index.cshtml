@model IEnumerable<CleanMadeira.Web.ViewModels.Propriedade.PropriedadeVM>

@{
    ViewData["Title"] = "Propriedades";
}

<div class="properties-header mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-house-door-fill text-primary me-2"></i>
            Propriedades
        </h2>
        <p class="text-muted">Gestão das propriedades registadas.</p>
    </div>

    <div class="properties-actions">
        <a asp-action="Inactive" class="btn btn-outline-secondary w-100">
            <i class="bi bi-archive-fill"></i>
            Desativadas
            <span class="badge bg-secondary ms-1">@ViewBag.InactiveCount</span>
        </a>

        <a asp-action="Create" class="btn btn-primary w-100">
            <i class="bi bi-plus-circle-fill"></i>
            Nova Propriedade
        </a>
    </div>

</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        Ainda não existem propriedades registadas.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-sm-12 col-md-6 col-xl-4">
                <div class="card property-card h-100">

                    <div class="property-header">
                        <i class="bi bi-house-door-fill"></i>
                        <span>@item.Nome</span>
                    </div>

                    <div class="card-body">

                        <div class="property-info">
                            <i class="bi bi-geo-alt-fill text-danger"></i>
                            <span>@item.Endereco</span>
                        </div>

                        <div class="property-info">
                            <i class="bi bi-map-fill text-success"></i>
                            <span>@item.Freguesia</span>
                        </div>

                        <hr />

                        <div class="property-actions d-flex flex-column flex-lg-row justify-content-between gap-2">

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-primary flex-fill">
                                <i class="bi bi-eye-fill me-1"></i>
                                Ver
                            </a>

                            <div class="d-flex gap-2 flex-fill">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-warning w-100">
                                    <i class="bi bi-pencil-fill me-1"></i>
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-danger w-100">
                                    <i class="bi bi-trash-fill me-1"></i>
                                    Eliminar
                                </a>
                            </div>

                        </div>

                    </div>

                </div>
            </div>
        }
    </div>
}

<style>
    .property-card {
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,.06);
        transition: .25s ease;
    }

        .property-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 32px rgba(0,0,0,.10);
        }

    .property-header {
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 1.25rem;
        font-weight: 600;
    }

        .property-header i {
            color: #0d6efd;
            font-size: 1.6rem;
        }

    .property-info {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
        color: #555;
        font-size: 1rem;
    }

        .property-info span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .properties-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 20px;
    }

    @@media (min-width: 992px) {
        .properties-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .properties-actions {
            display: flex;
            gap: 12px;
            margin-top: 0;
        }

            .properties-actions .btn {
                width: auto;
                min-width: 180px;
            }
    }
</style>
