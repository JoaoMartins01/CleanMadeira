@using CleanMadeira.Domain.Entities
@using CleanMadeira.Domain.Entities.Enums
@model IEnumerable<Company>

@{
    ViewData["Title"] = "Gestão de Empresas";

    var pendentes = Model.Count(c => c.Status == CompanyStatus.Pendente);
    var ativas = Model.Count(c => c.Status == CompanyStatus.Ativa);
    var rejeitadas = Model.Count(c => c.Status == CompanyStatus.Rejeitada);
    var suspensas = Model.Count(c => c.Status == CompanyStatus.Suspensa);
}

<div class="container-fluid py-4">

    <!-- CABEÇALHO -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-buildings me-2"></i>
                Gestão de Empresas
            </h1>

            <p class="text-muted mb-0">
                Consulte e valide as empresas registadas no CleanMadeira.
            </p>
        </div>

        @if (pendentes > 0)
        {
            <span class="badge rounded-pill
                bg-warning-subtle
                text-warning-emphasis
                px-3 py-2 fs-6">

                <i class="bi bi-hourglass-split me-1"></i>

                @pendentes
                @(pendentes == 1
                    ? "empresa pendente"
                    : "empresas pendentes")
            </span>
        }

    </div>


    <!-- RESUMO -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>
                            <div class="text-muted small">
                                Pendentes
                            </div>

                            <div class="fs-3 fw-bold">
                                @pendentes
                            </div>
                        </div>

                        <div class="summary-icon
                            bg-warning-subtle
                            text-warning">

                            <i class="bi bi-hourglass-split"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>


        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>
                            <div class="text-muted small">
                                Ativas
                            </div>

                            <div class="fs-3 fw-bold">
                                @ativas
                            </div>
                        </div>

                        <div class="summary-icon
                            bg-success-subtle
                            text-success">

                            <i class="bi bi-check-circle"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>


        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>
                            <div class="text-muted small">
                                Rejeitadas
                            </div>

                            <div class="fs-3 fw-bold">
                                @rejeitadas
                            </div>
                        </div>

                        <div class="summary-icon
                            bg-danger-subtle
                            text-danger">

                            <i class="bi bi-x-circle"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>


        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex
                        justify-content-between
                        align-items-center">

                        <div>
                            <div class="text-muted small">
                                Suspensas
                            </div>

                            <div class="fs-3 fw-bold">
                                @suspensas
                            </div>
                        </div>

                        <div class="summary-icon
                            bg-secondary-subtle
                            text-secondary">

                            <i class="bi bi-pause-circle"></i>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>


    <!-- EMPRESAS -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 p-3 p-md-4">

            <div class="d-flex justify-content-between
                align-items-center">

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Empresas registadas
                    </h2>

                    <div class="text-muted small">
                        @Model.Count() empresas
                    </div>
                </div>

            </div>

        </div>


        @if (!Model.Any())
        {
            <div class="card-body text-center py-5">

                <div class="empty-icon mb-3">
                    <i class="bi bi-buildings"></i>
                </div>

                <h3 class="h5 fw-semibold">
                    Nenhuma empresa registada
                </h3>

                <p class="text-muted mb-0">
                    Quando forem criadas empresas,
                    irão aparecer aqui.
                </p>

            </div>
        }
        else
        {
            <!-- DESKTOP -->
            <div class="table-responsive d-none d-md-block">

                <table class="table
                    table-hover
                    align-middle
                    mb-0">

                    <thead class="table-light">

                        <tr>
                            <th class="ps-4">
                                Empresa
                            </th>

                            <th>
                                Tipo
                            </th>

                            <th>
                                NIF
                            </th>

                            <th>
                                Contacto
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-end pe-4">
                                Ações
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var company in Model)
                        {
                            <tr>

                                <td class="ps-4">

                                    <div class="d-flex
                                        align-items-center
                                        gap-3">

                                        <div class="company-icon">
                                            <i class="bi bi-building"></i>
                                        </div>

                                        <div>

                                            <div class="fw-semibold">
                                                @company.Name
                                            </div>

                                            <div class="text-muted small">
                                                @company.Email
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    @if (company.Type ==
                                         CompanyType.Limpeza)
                                    {
                                        <span>
                                            <i class="bi bi-stars me-1"></i>
                                            Limpeza
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            <i class="bi bi-house-door me-1"></i>
                                            Alojamento Local
                                        </span>
                                    }

                                </td>


                                <td>
                                    @(string.IsNullOrWhiteSpace(company.Nif)
                                        ? "-"
                                        : company.Nif)
                                </td>


                                <td>

                                    @if (!string.IsNullOrWhiteSpace(company.Phone))
                                    {
                                        <div>
                                            <i class="bi bi-telephone
                                            me-1 text-muted"></i>

                                            @company.Phone
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <td>

                                    @switch (company.Status)
                                    {
                                        case CompanyStatus.Pendente:

                                            <span class="badge rounded-pill
                                                bg-warning-subtle
                                                text-warning-emphasis">

                                                <i class="bi bi-clock me-1"></i>
                                                Pendente

                                            </span>

                                            break;


                                        case CompanyStatus.Ativa:

                                            <span class="badge rounded-pill
                                                bg-success-subtle
                                                text-success-emphasis">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Ativa

                                            </span>

                                            break;


                                        case CompanyStatus.Rejeitada:

                                            <span class="badge rounded-pill
                                                bg-danger-subtle
                                                text-danger-emphasis">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Rejeitada

                                            </span>

                                            break;


                                        case CompanyStatus.Suspensa:

                                            <span class="badge rounded-pill
                                                bg-secondary-subtle
                                                text-secondary-emphasis">

                                                <i class="bi bi-pause-circle me-1"></i>
                                                Suspensa

                                            </span>

                                            break;
                                    }

                                </td>


                                <td class="text-end pe-4">

                                    <div class="d-inline-flex gap-1">

                                        @if (company.Status ==
                                             CompanyStatus.Pendente)
                                        {
                                            <form asp-action="Approve"
                                                  asp-route-id="@company.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn
                                                    btn-sm
                                                    btn-success">

                                                    <i class="bi bi-check-lg"></i>

                                                    <span class="d-none d-xl-inline">
                                                        Aprovar
                                                    </span>

                                                </button>

                                            </form>


                                            <form asp-action="Reject"
                                                  asp-route-id="@company.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn
                                                    btn-sm
                                                    btn-outline-danger">

                                                    <i class="bi bi-x-lg"></i>

                                                    <span class="d-none d-xl-inline">
                                                        Rejeitar
                                                    </span>

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- MOBILE -->
            <div class="d-md-none p-3">

                <div class="d-flex flex-column gap-3">

                    @foreach (var company in Model)
                    {
                        <div class="company-mobile-card">

                            <div class="d-flex
                                justify-content-between
                                align-items-start
                                gap-2 mb-3">

                                <div class="d-flex
                                    align-items-center
                                    gap-2">

                                    <div class="company-icon">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <div>

                                        <div class="fw-bold">
                                            @company.Name
                                        </div>

                                        <div class="text-muted small">
                                            @company.Type
                                        </div>

                                    </div>

                                </div>


                                @switch (company.Status)
                                {
                                    case CompanyStatus.Pendente:

                                        <span class="badge rounded-pill
                                            bg-warning-subtle
                                            text-warning-emphasis">

                                            Pendente

                                        </span>

                                        break;

                                    case CompanyStatus.Ativa:

                                        <span class="badge rounded-pill
                                            bg-success-subtle
                                            text-success-emphasis">

                                            Ativa

                                        </span>

                                        break;

                                    case CompanyStatus.Rejeitada:

                                        <span class="badge rounded-pill
                                            bg-danger-subtle
                                            text-danger-emphasis">

                                            Rejeitada

                                        </span>

                                        break;

                                    case CompanyStatus.Suspensa:

                                        <span class="badge rounded-pill
                                            bg-secondary-subtle
                                            text-secondary-emphasis">

                                            Suspensa

                                        </span>

                                        break;
                                }

                            </div>


                            <div class="company-details">

                                <div>
                                    <span>NIF</span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(company.Nif)
                                            ? "-"
                                            : company.Nif)
                                    </strong>
                                </div>

                                <div>
                                    <span>Email</span>

                                    <strong class="text-break">
                                        @company.Email
                                    </strong>
                                </div>

                                <div>
                                    <span>Telefone</span>

                                    <strong>
                                        @(string.IsNullOrWhiteSpace(company.Phone)
                                            ? "-"
                                            : company.Phone)
                                    </strong>
                                </div>

                            </div>


                            @if (company.Status ==
                                 CompanyStatus.Pendente)
                            {
                                <div class="d-grid
                                    grid-mobile-actions
                                    gap-2 mt-3">

                                    <form asp-action="Approve"
                                          asp-route-id="@company.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn
                                            btn-success
                                            w-100">

                                            <i class="bi bi-check-lg me-1"></i>
                                            Aprovar

                                        </button>

                                    </form>


                                    <form asp-action="Reject"
                                          asp-route-id="@company.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn
                                            btn-outline-danger
                                            w-100">

                                            <i class="bi bi-x-lg me-1"></i>
                                            Rejeitar

                                        </button>

                                    </form>

                                </div>
                            }

                        </div>
                    }

                </div>

            </div>
        }

    </div>

</div>


<style>

    .summary-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.4rem;
    }


    .company-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 1.2rem;
    }


    .empty-icon {
        width: 70px;
        height: 70px;
        margin-left: auto;
        margin-right: auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f3f5;
        color: #6c757d;
        font-size: 2rem;
    }


    .company-mobile-card {
        border: 1px solid #e9ecef;
        border-radius: 16px;
        padding: 16px;
        background: white;
    }


    .company-details {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }


        .company-details > div {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            font-size: .9rem;
        }


        .company-details span {
            color: #6c757d;
        }


        .company-details strong {
            text-align: right;
            font-weight: 500;
        }


    .grid-mobile-actions {
        grid-template-columns: 1fr 1fr;
    }


    @@media (max-width: 420px) {

        .grid-mobile-actions {
            grid-template-columns: 1fr;
        }

        .company-details > div {
            flex-direction: column;
            gap: 2px;
        }

        .company-details strong {
            text-align: left;
        }
    }

</style>