@model CleanMadeira.Web.ViewModels.CleaningTask.AssignCleanerVM

@{
    ViewData["Title"] = "Atribuir Limpador";
}

<div class="mb-4">
    <a asp-action="Details"
       asp-route-id="@Model.CleaningTaskId"
       class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>
        Voltar aos detalhes
    </a>
</div>

<div class="card border-0 shadow-sm mb-4 assign-cleaner-summary">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            <div class="summary-icon">
                <i class="bi bi-house-door-fill"></i>
            </div>

            <div>
                <small class="text-muted">Limpeza</small>

                <h4 class="fw-bold mb-1">
                    @Model.PropriedadeNome
                </h4>

                <div class="text-muted">
                    <i class="bi bi-calendar-event me-1"></i>
                    @Model.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-search text-primary me-2"></i>
            Procurar limpador
        </h5>

        <form asp-action="AssignCleaner"
              method="get"
              class="row g-2">

            <input type="hidden"
                   name="id"
                   value="@Model.CleaningTaskId" />

            <div class="col-md-9">
                <input type="search"
                       name="search"
                       value="@Model.Search"
                       class="form-control"
                       placeholder="Código, nome, email ou telefone" />
            </div>

            <div class="col-md-3">
                <button type="submit"
                        class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>
                    Procurar
                </button>
            </div>

        </form>

        <div class="form-text mt-2">
            Pode pesquisar, por exemplo, por
            <strong>LMP-7A31C9F2</strong>,
            nome, email ou telefone.
        </div>

    </div>
</div>

@if (!Model.Cleaners.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle-fill me-2"></i>

        @if (string.IsNullOrWhiteSpace(Model.Search))
        {
            <span>Não existem limpadores disponíveis.</span>
        }
        else
        {
            <span>
                Não foi encontrado nenhum limpador para
                <strong>@Model.Search</strong>.
            </span>
        }
    </div>
}
else
{
    <form asp-action="AssignCleaner"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="CleaningTaskId"
               type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <span asp-validation-for="SelectedCleanerId"
              class="text-danger d-block mb-3">
        </span>

        <div class="row g-4">
            @foreach (var cleaner in Model.Cleaners)
            {
                var isSelected =
                    Model.SelectedCleanerId == cleaner.Id;

                <div class="col-12 col-lg-6">
                    <label class="cleaner-card">

                        <input type="radio"
                               asp-for="SelectedCleanerId"
                               value="@cleaner.Id"
                               class="cleaner-radio" />

                        <div class="cleaner-card-body">

                            <div class="cleaner-avatar">
                                <i class="bi bi-person-fill"></i>
                            </div>

                            <div class="cleaner-content">

                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <h5 class="fw-bold mb-1">
                                            @cleaner.NomeCompleto
                                        </h5>

                                        <span class="cleaner-code">
                                            <i class="bi bi-upc-scan me-1"></i>
                                            @cleaner.LimpadorCodigo
                                        </span>
                                        <div class="mt-2">
                                            @if (cleaner.CompanyId.HasValue)
                                            {
                                                <span class="badge bg-primary-subtle text-primary">
                                                    <i class="bi bi-building me-1"></i>
                                                    @cleaner.CompanyName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">
                                                    <i class="bi bi-person-workspace me-1"></i>
                                                    Independente
                                                </span>
                                            }
                                        </div>
                                    </div>

                                    <div class="selected-indicator">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                </div>

                                <div class="cleaner-details mt-3">

                                    <div>
                                        <i class="bi bi-envelope-fill"></i>

                                        <span>
                                            @(string.IsNullOrWhiteSpace(cleaner.Email)
                                                ? "Email não disponível"
                                                : cleaner.Email)
                                        </span>
                                    </div>

                                    <div>
                                        <i class="bi bi-telephone-fill"></i>

                                        <span>
                                            @(string.IsNullOrWhiteSpace(cleaner.Telemovel)
                                                ? "Telefone não disponível"
                                                : cleaner.Telemovel)
                                        </span>
                                    </div>

                                </div>

                            </div>

                        </div>
                    </label>
                </div>
            }
        </div>

        <div class="assign-actions mt-4">
            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-person-check-fill me-1"></i>

                @(Model.SelectedCleanerId.HasValue
                    ? "Confirmar limpador"
                    : "Atribuir limpador")
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.CleaningTaskId"
               class="btn btn-outline-secondary">
                Cancelar
            </a>
        </div>

    </form>
}

<style>
    .assign-cleaner-summary {
        border-radius: 18px;
    }

    .summary-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 15px;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
    }

    .cleaner-card {
        display: block;
        height: 100%;
        padding: 0;
        cursor: pointer;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 7px 22px rgba(15, 23, 42, .07);
        transition: border-color .15s ease, box-shadow .15s ease, transform .15s ease;
    }

        .cleaner-card:hover {
            transform: translateY(-2px);
            border-color: #9ec5fe;
            box-shadow: 0 12px 30px rgba(15, 23, 42, .11);
        }

        .cleaner-card.selected,
        .cleaner-card:has(.cleaner-radio:checked) {
            border: 2px solid #0d6efd;
            background: #f7faff;
        }

    .cleaner-radio {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .cleaner-card-body {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 20px;
    }

    .cleaner-avatar {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #eaf2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
    }

    .cleaner-content {
        min-width: 0;
        flex: 1;
    }

    .cleaner-code {
        display: inline-flex;
        align-items: center;
        padding: 4px 9px;
        border-radius: 999px;
        background: #eef2f7;
        color: #475569;
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .03em;
    }

    .cleaner-details {
        display: grid;
        gap: 8px;
        color: #64748b;
        font-size: .9rem;
    }

        .cleaner-details div {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
        }

        .cleaner-details i {
            width: 18px;
            flex-shrink: 0;
            text-align: center;
        }

        .cleaner-details span {
            overflow-wrap: anywhere;
        }

    .selected-indicator {
        color: #0d6efd;
        font-size: 1.25rem;
        opacity: 0;
    }

    .cleaner-card:has(.cleaner-radio:checked) .selected-indicator {
        opacity: 1;
    }

    .assign-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    @@media (max-width: 768px) {
        .cleaner-card-body {
            padding: 16px;
        }

        .cleaner-avatar {
            width: 44px;
            height: 44px;
            font-size: 1.25rem;
        }

        .assign-actions {
            flex-direction: column;
        }

            .assign-actions .btn {
                width: 100%;
            }
    }
</style>