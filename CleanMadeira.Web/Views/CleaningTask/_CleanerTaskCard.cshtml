@using CleanMadeira.Domain.Entities
@using CleanMadeira.Domain.Enums
@model CleanMadeira.Web.ViewModels.CleaningTask.CleaningTaskVM

@{
    var cardClass = Model.Status switch
    {
        CleaningStatus.EmProgresso => "task-progress",
        CleaningStatus.Pendente => "task-pending",
        CleaningStatus.Completo => "task-completed",
        _ => ""
    };

    var badgeClass = Model.Status switch
    {
        CleaningStatus.EmProgresso => "bg-primary",
        CleaningStatus.Pendente => "bg-warning text-dark",
        CleaningStatus.Completo => "bg-success",
        _ => "bg-secondary"
    };

    var icon = Model.Status switch
    {
        CleaningStatus.EmProgresso => "bi-play-circle-fill",
        CleaningStatus.Pendente => "bi-hourglass-split",
        CleaningStatus.Completo => "bi-check-circle-fill",
        _ => "bi-info-circle-fill"
    };
}

<div class="card shadow-sm cleaner-task-card @cardClass">
    <div class="card-body d-flex justify-content-between align-items-center gap-3 flex-wrap">

        <div>
            <h5 class="fw-bold mb-1">
                <i class="bi bi-house-door-fill text-primary me-2"></i>
                @Model.PropriedadeNome
            </h5>

            <div class="small text-muted">
                <i class="bi bi-clock-fill me-1"></i>
                @Model.ScheduledDate.ToString("dd/MM/yyyy HH:mm")
            </div>

            <div class="small text-muted">
                <i class="bi bi-flag-fill me-1"></i>
                Prioridade: @Model.Prioridade
            </div>

            <span class="badge @badgeClass mt-2">
                <i class="bi @icon me-1"></i>
                @Model.Status
            </span>
        </div>

        <a asp-controller="CleaningTask"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary btn-sm">
            <i class="bi bi-eye-fill"></i>
            Ver
        </a>

    </div>
</div>
