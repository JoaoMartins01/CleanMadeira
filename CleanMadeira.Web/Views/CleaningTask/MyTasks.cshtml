@using CleanMadeira.Domain.Entities
@using CleanMadeira.Domain.Enums
@model IEnumerable<CleanMadeira.Web.ViewModels.CleaningTask.CleaningTaskVM>

@{
    ViewData["Title"] = "As Minhas Limpezas";

    var emProgresso = Model
        .Where(t => t.Status == CleaningStatus.EmProgresso)
        .OrderBy(t => t.ScheduledDate)
        .ToList();

    var pendentes = Model
        .Where(t => t.Status == CleaningStatus.Pendente)
        .OrderBy(t => t.ScheduledDate)
        .ToList();

    var concluidas = Model
        .Where(t => t.Status == CleaningStatus.Completo)
        .OrderByDescending(t => t.ScheduledDate)
        .ToList();
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">As Minhas Limpezas</h2>
    <p class="text-muted mb-0">
        Veja as tarefas atribuídas a si, organizadas por estado.
    </p>
</div>

<form method="get" class="row g-2 mb-4">

    <div class="col-md-5">
        <select name="status" class="form-select">
            <option value="todas" selected="@(ViewBag.Status == "todas")">Todas</option>
            <option value="emprogresso" selected="@(ViewBag.Status == "emprogresso")">Em progresso</option>
            <option value="pendentes" selected="@(ViewBag.Status == "pendentes")">Pendentes</option>
            <option value="concluidas" selected="@(ViewBag.Status == "concluidas")">Concluídas</option>
        </select>
    </div>

    <div class="col-md-5">
        <select name="periodo" class="form-select">
            <option value="hoje" selected="@(ViewBag.Periodo == "hoje")">Hoje</option>
            <option value="semana" selected="@(ViewBag.Periodo == "semana")">Próximos 7 dias</option>
            <option value="mes" selected="@(ViewBag.Periodo == "mes")">Este mês</option>
            <option value="todas" selected="@(ViewBag.Periodo == "todas")">Todas as datas</option>
        </select>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-funnel-fill"></i>
            Filtrar
        </button>
    </div>

</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle-fill me-2"></i>
        Não tem limpezas atribuídas.
    </div>
}
else
{
    <section class="mb-5">
        <h4 class="fw-bold mb-3">
            <i class="bi bi-play-circle-fill text-primary me-2"></i>
            Em Progresso (@emProgresso.Count)
        </h4>

        @if (!emProgresso.Any())
        {
            <div class="alert alert-light border">
                Nenhuma tarefa em progresso.
            </div>
        }
        else
        {
            @foreach (var task in emProgresso)
            {
                <partial name="_CleanerTaskCard" model="task" />
            }
        }
    </section>

    <section class="mb-5">
        <h4 class="fw-bold mb-3">
            <i class="bi bi-hourglass-split text-warning me-2"></i>
            Pendentes (@pendentes.Count)
        </h4>

        @if (!pendentes.Any())
        {
            <div class="alert alert-light border">
                Nenhuma tarefa pendente.
            </div>
        }
        else
        {
            @foreach (var task in pendentes)
            {
                <partial name="_CleanerTaskCard" model="task" />
            }
        }
    </section>

    <section>
        <h4 class="fw-bold mb-3">
            <i class="bi bi-check-circle-fill text-success me-2"></i>
            Concluídas (@concluidas.Count)
        </h4>

        @if (!concluidas.Any())
        {
            <div class="alert alert-light border">
                Nenhuma tarefa concluída.
            </div>
        }
        else
        {
            @foreach (var task in concluidas)
            {
                <partial name="_CleanerTaskCard" model="task" />
            }
        }
    </section>
}

<style>
    .cleaner-task-card {
        border: 0;
        border-left: 6px solid transparent;
        border-radius: 16px;
        margin-bottom: 14px;
    }

    .task-progress {
        border-left-color: #0d6efd;
    }

    .task-pending {
        border-left-color: #ffc107;
    }

    .task-completed {
        border-left-color: #198754;
    }
</style>