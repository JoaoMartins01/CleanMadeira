@model CleanMadeira.Web.ViewModels.CleaningTask.CleaningTaskVM

@{
    ViewData["Title"] = "Notas e Fotos";
}

<h2>Notas e Fotos</h2>

<p class="text-muted">@Model.PropriedadeNome</p>

<form asp-action="AddCleanerUpdate"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="hidden" name="taskId" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Notas da limpeza</label>

        <textarea name="cleanerNotes"
                  class="form-control"
                  rows="5">@Model.CleanerNotes</textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">
            Fotografias
        </label>

        <input type="file"
               name="photos"
               id="photos"
               class="form-control"
               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
               multiple />

        <div class="form-text">
            Máximo de 10 fotografias, até 10 MB cada.
            Serão otimizadas automaticamente.
        </div>

        <div id="photoValidation"
             class="text-danger mt-2"></div>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="bi bi-save-fill"></i>
        Guardar
    </button>

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        Voltar
    </a>
</form>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("photos");
        const validation = document.getElementById("photoValidation");

        if (!input || !validation) {
            return;
        }

        input.addEventListener("change", function () {
            validation.textContent = "";

            const files = Array.from(input.files);
            const maximumFiles = 10;
            const maximumBytes = 10 * 1024 * 1024;
            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (files.length > maximumFiles) {
                validation.textContent =
                    "Só pode selecionar até 10 fotografias.";

                input.value = "";
                return;
            }

            const invalidFile = files.find(file =>
                file.size > maximumBytes ||
                !allowedTypes.includes(file.type)
            );

            if (invalidFile) {
                validation.textContent =
                    `"${invalidFile.name}" tem um formato inválido ou excede 10 MB.`;

                input.value = "";
            }
        });
    });
</script>