@model CleanMadeira.Web.ViewModels.CleaningTask.CleaningTaskVM

@{
    ViewData["Title"] = "Notas e Fotos";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="text-decoration-none small">

                <i class="bi bi-arrow-left me-1"></i>
                Voltar à limpeza

            </a>

            <h1 class="h3 fw-bold mt-2 mb-1">
                <i class="bi bi-camera-fill me-2 text-primary"></i>
                Notas e Fotografias
            </h1>

            <p class="text-muted mb-0">
                @Model.PropriedadeNome
            </p>

        </div>

    </div>


    <form asp-action="AddCleanerUpdate"
          method="post"
          enctype="multipart/form-data"
          id="cleanerUpdateForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="taskId"
               value="@Model.Id" />


        <div class="row g-4">

            <!-- NOTAS -->
            <div class="col-12 col-lg-7">

                <div class="card border-0 shadow-sm form-card h-100">

                    <div class="card-header bg-white">

                        <h2 class="h5 fw-bold mb-1">
                            <i class="bi bi-journal-text me-2 text-primary"></i>
                            Notas da limpeza
                        </h2>

                        <p class="text-muted small mb-0">
                            Registe observações importantes sobre o estado
                            da propriedade ou sobre o trabalho realizado.
                        </p>

                    </div>

                    <div class="card-body">

                        <textarea name="cleanerNotes"
                                  class="form-control notes-textarea"
                                  rows="10"
                                  placeholder="Ex.: Limpeza concluída. Foram encontrados danos na mesa da sala...">@Model.CleanerNotes</textarea>

                        <div class="form-text mt-2">

                            <i class="bi bi-info-circle me-1"></i>
                            Estas notas ficam associadas à tarefa de limpeza.

                        </div>

                    </div>

                </div>

            </div>


            <!-- FOTOS -->
            <div class="col-12 col-lg-5">

                <div class="card border-0 shadow-sm form-card">

                    <div class="card-header bg-white">

                        <h2 class="h5 fw-bold mb-1">
                            <i class="bi bi-images me-2 text-primary"></i>
                            Fotografias
                        </h2>

                        <p class="text-muted small mb-0">
                            Adicione fotografias do trabalho realizado.
                        </p>

                    </div>

                    <div class="card-body">

                        <label for="photos"
                               class="photo-upload-area"
                               id="photoUploadArea">

                            <div class="upload-icon">
                                <i class="bi bi-cloud-arrow-up"></i>
                            </div>

                            <div class="fw-semibold">
                                Selecionar fotografias
                            </div>

                            <div class="text-muted small mt-1">
                                Clique aqui para escolher os ficheiros
                            </div>

                            <input type="file"
                                   name="photos"
                                   id="photos"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   multiple
                                   hidden />

                        </label>


                        <div class="mt-3">

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success"></i>

                                <span class="small">
                                    Máximo de 10 fotografias
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2 mb-2">
                                <i class="bi bi-check-circle-fill text-success"></i>

                                <span class="small">
                                    Até 10 MB por fotografia
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success"></i>

                                <span class="small">
                                    JPG, PNG ou WebP
                                </span>
                            </div>

                        </div>


                        <div id="selectedPhotos"
                             class="selected-photos mt-3 d-none">

                            <div class="fw-semibold small mb-2">
                                Fotografias selecionadas
                            </div>

                            <div id="selectedPhotosList"
                                 class="d-flex flex-column gap-2">
                            </div>

                        </div>


                        <div id="photoValidation"
                             class="alert alert-danger mt-3 mb-0 d-none"
                             role="alert">
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- AÇÕES -->
        <div class="form-actions mt-4">

            <button type="submit"
                    class="btn btn-primary btn-lg">

                <i class="bi bi-save-fill me-1"></i>
                Guardar atualização

            </button>

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-lg">

                Cancelar

            </a>

        </div>

    </form>

</div>


<style>

    .form-card {
        border-radius: 18px;
        overflow: hidden;
    }

        .form-card .card-header {
            padding: 20px 22px;
            border-bottom: 1px solid #e9ecef;
        }

        .form-card .card-body {
            padding: 22px;
        }

    .notes-textarea {
        min-height: 260px;
        resize: vertical;
        border-radius: 12px;
    }

    .photo-upload-area {
        width: 100%;
        min-height: 190px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        cursor: pointer;
        padding: 24px;
        border: 2px dashed #b6c5d8;
        border-radius: 16px;
        background: #f8fafc;
        transition: border-color .2s ease, background-color .2s ease;
    }

        .photo-upload-area:hover {
            border-color: #0d6efd;
            background: #f0f6ff;
        }

    .upload-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 50%;
        background: #e7f1ff;
        color: #0d6efd;
        font-size: 1.7rem;
    }

    .selected-photo-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        background: #f8f9fa;
        border-radius: 10px;
    }

    .selected-photo-name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .9rem;
    }

    .selected-photo-size {
        flex-shrink: 0;
        color: #6c757d;
        font-size: .8rem;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }


    @@media (max-width: 767.98px) {

        .container {
            padding-left: 12px;
            padding-right: 12px;
        }

        .form-card .card-header,
        .form-card .card-body {
            padding: 16px;
        }

        .notes-textarea {
            min-height: 200px;
        }

        .photo-upload-area {
            min-height: 160px;
            padding: 20px 14px;
        }

        .form-actions {
            display: grid;
            grid-template-columns: 1fr;
        }

            .form-actions .btn {
                width: 100%;
            }
    }

</style>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const input =
                document.getElementById("photos");

            const validation =
                document.getElementById("photoValidation");

            const selectedPhotos =
                document.getElementById("selectedPhotos");

            const selectedPhotosList =
                document.getElementById("selectedPhotosList");

            if (!input ||
                !validation ||
                !selectedPhotos ||
                !selectedPhotosList) {
                return;
            }


            const maximumFiles = 10;
            const maximumBytes =
                10 * 1024 * 1024;

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];


            function formatFileSize(bytes) {

                if (bytes < 1024 * 1024) {
                    return (
                        bytes / 1024
                    ).toFixed(1) + " KB";
                }

                return (
                    bytes /
                    (1024 * 1024)
                ).toFixed(1) + " MB";
            }


            function showError(message) {

                validation.textContent =
                    message;

                validation.classList.remove(
                    "d-none"
                );
            }


            function clearError() {

                validation.textContent = "";

                validation.classList.add(
                    "d-none"
                );
            }


            function clearSelection() {

                input.value = "";

                selectedPhotosList.innerHTML = "";

                selectedPhotos.classList.add(
                    "d-none"
                );
            }


            input.addEventListener(
                "change",
                function() {

                    clearError();

                    selectedPhotosList.innerHTML = "";

                    const files =
                        Array.from(input.files);


                    if (files.length === 0) {

                        selectedPhotos.classList.add(
                            "d-none"
                        );

                        return;
                    }


                    if (files.length > maximumFiles) {

                        showError(
                            "Só pode selecionar até 10 fotografias."
                        );

                        clearSelection();

                        return;
                    }


                    const invalidFile =
                        files.find(
                            file =>
                                file.size >
                                maximumBytes ||
                                !allowedTypes
                                    .includes(file.type)
                        );


                    if (invalidFile) {

                        showError(
                            `"${invalidFile.name}" tem um formato inválido ou excede 10 MB.`
                        );

                        clearSelection();

                        return;
                    }


                    files.forEach(
                        function(file) {

                            const item =
                                document.createElement(
                                    "div"
                                );

                            item.className =
                                "selected-photo-item";

                            item.innerHTML = `
                                    <div class="d-flex
                                                align-items-center
                                                gap-2
                                                min-w-0">

                                        <i class="bi bi-image
                                                  text-primary">
                                        </i>

                                        <span class="selected-photo-name">
                                            ${file.name}
                                        </span>

                                    </div>

                                    <span class="selected-photo-size">
                                        ${formatFileSize(file.size)}
                                    </span>
                                `;

                            selectedPhotosList
                                .appendChild(item);
                        }
                    );


                    selectedPhotos.classList.remove(
                        "d-none"
                    );
                }
            );

        }
    );

</script>