@model CreateCleaningTaskVM

@{
    ViewData["Title"] = "Calendário de Limpezas";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css"
      rel="stylesheet" />

<style>
    #calendar {
        min-height: 700px;
    }

    .calendar-event {
        font-size: 12px;
        line-height: 1.3;
        padding: 2px;
        white-space: normal;
    }

    .calendar-legend {
        background: #fff;
        border-radius: 8px;
    }

    .legend-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px 14px;
        margin-bottom: 10px;
    }

        .legend-row:last-child {
            margin-bottom: 0;
        }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
    }

        .legend-item i {
            font-size: 0.95rem;
        }

    @@media (max-width: 576px) {
        .legend-row {
            gap: 8px 10px;
        }

        .legend-item {
            font-size: 0.9rem;
        }

        .calendar-legend {
            font-size: 0.9rem;
        }
    }

    .fc-daygrid-event {
        white-space: normal !important;
        align-items: flex-start !important;
    }

    .fc-event-main-frame {
        display: block !important;
    }

    .fc-event-title-container {
        display: block !important;
    }

    .fc-event-title {
        display: block !important;
        white-space: normal !important;
    }

    .event-time {
        font-weight: 700;
        display: block;
    }

    .event-title-line {
        display: block;
    }

    .fc-daygrid-dot-event {
        display: flex !important;
        align-items: flex-start !important;
    }

    .fc-daygrid-event-dot {
        margin-top: 3px !important;
        align-self: flex-start;
    }

    .fc-event-main {
        display: flex;
        flex-direction: column;
    }

    .fc-daygrid-event-dot {
        display: none !important;
    }

    .calendar-event-custom {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        width: 100%;
    }

    .event-content {
        min-width: 0;
        flex: 1;
    }

    .event-title-line {
        display: flex;
        align-items: center;
        gap: 5px;
        min-width: 0;
    }

        .event-title-line i {
            display: inline-block !important;
            flex-shrink: 0;
        }

    .event-property-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    @@media (max-width: 576px) {

        .event-title-line {
            display: flex !important;
            align-items: center;
            gap: 4px;
        }

            .event-title-line i {
                display: inline-block !important;
            }

        .event-time {
            font-size: 0.75rem;
        }

        .event-property-name {
            font-size: 0.85rem;
        }
    }

    .priority-indicator {
        width: 6px;
        min-width: 6px;
        height: 34px;
        border-radius: 4px;
        margin-top: 2px;
    }

    .priority-low {
        background: #198754;
    }

    .priority-normal {
        background: #0d6efd;
    }

    .priority-high {
        background: #fd7e14;
    }

    .priority-urgent {
        background: #dc3545;
    }

    .event-time {
        font-weight: 700;
        line-height: 1.1;
    }

    .event-title-line {
        line-height: 1.2;
    }

    .contact-actions {
        display: none;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .event-without-cleaner {
        border: 1px dashed #dc3545 !important;
    }

    .event-without-cleaner .event-title-line {
            font-weight: 700;
    }

    .modal-footer {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        width: 100%;
        padding: 16px;
        justify-content: stretch;
    }

        .modal-footer .btn {
            width: 100%;
            min-height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 !important;
            white-space: nowrap;
        }

        .modal-footer .btn-details {
            grid-column: 1 / -1;
        }

        .modal-footer .delete-form {
            width: 100%;
            margin: 0;
        }

    @@media (max-width: 576px) {

        modal-footer {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

            .modal-footer .btn {
                font-size: 0.9rem;
                padding-left: 8px;
                padding-right: 8px;
            }
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Calendário de Limpezas</h2>
        <p class="text-muted mb-0">
            Clique num dia para criar uma nova limpeza.
        </p>
    </div>
</div>

<button type="button"
        class="btn btn-primary mb-3"
        id="newCleaningBtn">
    <i class="bi bi-plus-circle-fill me-1"></i>
    Nova limpeza
</button>

<br />
<div class="calendar-legend">

    <div class="legend-row">
        <strong>Prioridade:</strong>

        <span class="badge bg-success">Baixa</span>
        <span class="badge bg-primary">Normal</span>
        <span class="badge bg-warning text-dark">Alta</span>
        <span class="badge bg-danger">Urgente</span>
    </div>

    <div class="legend-row">
        <span class="legend-item">
            <i class="bi bi-hourglass-split text-warning"></i>
            Pendente
        </span>

        <span class="legend-item">
            <i class="bi bi-play-circle-fill text-primary"></i>
            Em progresso
        </span>

        <span class="legend-item">
            <i class="bi bi-check-circle-fill text-success"></i>
            Concluída
        </span>

        <span class="legend-item">
            <i class="bi bi-person-x-fill text-danger"></i>
            Sem limpador atribuído
        </span>
    </div>

</div>

<form method="get" class="row g-2 mb-4">

    <div class="col-md-5">
        <select id="statusFilter" class="form-select">
            <option value="">Todos</option>
            <option value="Geral">Geral</option>
            <option value="Exterior">Exterior</option>
            <option value="Janelas">Janelas</option>
            <option value="Intermediário">Intermédia</option>
            <option value="PosConstrucao">Pós-construção</option>
        </select>
    </div>
</form>


<div class="card shadow-sm">
    <div class="card border-0 shadow-sm calendar-card">
        <div class="card-body">
            <div id="calendar"></div>
        </div>
    </div>
    <div class="modal fade" id="cleaningModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">

                <form asp-controller="CleaningTask"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="ScheduledDate"
                           type="hidden"
                           id="scheduledDate" />
                    <div class="modal-header">
                        <h5 class="modal-title">Nova Limpeza</h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Data</label>
                                <input type="date"
                                       id="taskDate"
                                       class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PropriedadeId"
                                   class="form-label">
                            </label>

                            <select asp-for="PropriedadeId"
                                    asp-items="ViewBag.Propriedades"
                                    class="form-select">
                                <option value="">Selecionar propriedade</option>
                            </select>

                            <span asp-validation-for="PropriedadeId"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TipoServico"
                                   class="form-label">
                            </label>

                            <select asp-for="TipoServico"
                                    class="form-select">
                                <option value="1">Geral</option>
                                <option value="2">Exterior</option>
                                <option value="3">Janelas</option>
                                <option value="4">Intemerdiário</option>
                                <option value="5">PosConstrucao</option>
                            </select>

                            <span asp-validation-for="TipoServico"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                Hora
                            </label>

                            <input type="time"
                                   id="taskTime"
                                   class="form-control"
                                   value="10:00" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Prioridade"
                                   class="form-label">
                            </label>

                            <select asp-for="Prioridade"
                                    class="form-select">
                                <option value="1">Baixa</option>
                                <option value="2">Normal</option>
                                <option value="3">Alta</option>
                                <option value="4">Urgente</option>
                            </select>

                            <span asp-validation-for="Prioridade"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EstimatedMinutes"
                                   class="form-label">
                            </label>

                            <input asp-for="EstimatedMinutes"
                                   class="form-control"
                                   value="90" />

                            <span asp-validation-for="EstimatedMinutes"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notas"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notas"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="Notas"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            Guardar Limpeza
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
   <div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-calendar-check me-2"></i>
                    Detalhes da Limpeza
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <p>
                    <i class="bi bi-house-door-fill text-primary me-2"></i>
                    <strong>Propriedade:</strong>
                    <span id="detailsProperty"></span>
                </p>

                <p>
                    <i class="bi bi-person-fill text-primary me-2"></i>
                    <strong>Funcionária:</strong>
                    <span id="detailsCleaner"></span>
                        <div class="mb-3">
                            <small class="text-muted d-block">Contacto do funcionário</small>

                            <span id="detailsCleanerPhone">
                                Não disponível
                            </span>
                        </div>

                        <div id="detailsContactActions"
                             class="d-flex gap-2 mb-3"
                             style="display:flex !important;">

                            <a id="detailsCallBtn"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-telephone-fill me-1"></i>
                                Ligar
                            </a>

                            <a id="detailsWhatsappBtn"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-success btn-sm">
                                <i class="bi bi-whatsapp me-1"></i>
                                WhatsApp
                            </a>
                        </div>
                </p>

                <p>
                    <i class="bi bi-clock-fill text-primary me-2"></i>
                    <strong>Data/Hora:</strong>
                    <span id="detailsDate"></span>
                </p>

                <p>
                    <i class="bi bi-flag-fill text-warning me-2"></i>
                    <strong>Prioridade:</strong>
                    <span id="detailsPriority"></span>
                </p>

                <p>
                    <i class="bi bi-info-circle-fill text-success me-2"></i>
                    <strong>Estado:</strong>
                    <span id="detailsStatus"></span>
                </p>

            </div>

            <div class="modal-footer">
                    <a id="detailsFullBtn"
                       class="btn btn-primary">
                        <i class="bi bi-eye-fill"></i>
                        Ver detalhes completos
                    </a>

                    <a id="assignCleanerBtn"
                       class="btn btn-primary">
                        <i class="bi bi-person-plus-fill me-1"></i>
                        Atribuir limpador
                    </a>

                    <a id="detailsEditBtn"
                       class="btn btn-outline-warning">
                        <i class="bi bi-pencil-square"></i>
                        Editar
                    </a>

                    <a id="detailsDeleteBtn"
                       class="btn btn-outline-danger">
                        <i class="bi bi-trash-fill"></i>
                        Eliminar
                    </a>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Fechar
                    </button>
             </div>

        </div>
    </div>
</div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

    <script>


        document.addEventListener("DOMContentLoaded", function () {
        const calendarEl = document.getElementById("calendar");
        const scheduledDateInput = document.getElementById("scheduledDate");
        const taskTimeInput = document.getElementById("taskTime");
        const taskDateInput = document.getElementById("taskDate");
        const cleaningModalElement = document.getElementById("cleaningModal");
        const detailsModalElement = document.getElementById("detailsModal");


        const newCleaningBtn = document.getElementById("newCleaningBtn");

        const cleaningModal = cleaningModalElement
        ? new bootstrap.Modal(cleaningModalElement)
        : null;

        function updateScheduledDate() {
        if (taskDateInput && taskTimeInput && scheduledDateInput) {
        
        scheduledDateInput.value =
        taskDateInput.value + "T" + taskTimeInput.value;
        }
        }

        taskDateInput.addEventListener(
        "change",
        updateScheduledDate
        );

        taskTimeInput.addEventListener(
        "change",
        updateScheduledDate
        );

        if (newCleaningBtn) {
        newCleaningBtn.addEventListener("click", function () {
        const today = new Date();

        taskDateInput.value =
        today.getFullYear() + "-" +
        String(today.getMonth() + 1).padStart(2, "0") + "-" +
        String(today.getDate()).padStart(2, "0");

        if (!taskTimeInput.value) {
        taskTimeInput.value = "10:00";
        }

        updateScheduledDate();

        if (cleaningModal) {
        cleaningModal.show();
        }
        });
        }


        

        const detailsModal = detailsModalElement
        ? new bootstrap.Modal(detailsModalElement)
        : null;

        const calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: window.innerWidth < 768 ? "listWeek" : "dayGridMonth",
        locale: "pt",
        height: 700,
        selectable: true,

        headerToolbar: window.innerWidth < 768
        ? {
        left: "prev,next",
        center: "title",
        right: "today"
        }
        : {
        left: "prev,next today",
        center: "title",
        right: "dayGridMonth,timeGridWeek,timeGridDay"
        },

        buttonText: {
        today: "Hoje",
        month: "Mês",
        week: "Semana",
        day: "Dia"
        },

        dateClick: function (info) {
        if (scheduledDateInput && taskTimeInput) {
        // Preenche o campo Data do formulário
        taskDateInput.value = info.dateStr;

        // Junta a data e a hora para o campo hidden
        scheduledDateInput.value =
        taskDateInput.value + "T" + taskTimeInput.value;
        }

        if (cleaningModal) {
        cleaningModal.show();
        }
        },

        displayEventTime: false,

                events: function(fetchInfo, successCallback, failureCallback) {
                    const status = document
                        .getElementById("statusFilter")
                        .value;

                    const url =
                        `/CleaningTask/GetEvents?status=${encodeURIComponent(status)}`;

                    fetch(url)
                        .then(response => {
                            if (!response.ok) {
                                throw new Error("Erro ao carregar as tarefas.");
                            }

                            return response.json();
                        })
                        .then(events => successCallback(events))
                        .catch(error => failureCallback(error));
                },

                eventDidMount: function(info) {
                    const props = info.event.extendedProps;

                    let icon = "";

                    switch (props.estado) {
                        case "Pendente":
                            icon = '<i class="bi bi-hourglass-split text-warning"></i>';
                            break;

                        case "EmProgresso":
                            icon = '<i class="bi bi-play-circle-fill text-primary"></i>';
                            break;

                        case "Completo":
                            icon = '<i class="bi bi-check-circle-fill text-success"></i>';
                            break;
                    }

                    let priorityClass = "";

                    switch (props.prioridade) {
                        case "Baixa":
                            priorityClass = "priority-low";
                            break;

                        case "Normal":
                            priorityClass = "priority-normal";
                            break;

                        case "Alta":
                            priorityClass = "priority-high";
                            break;

                        case "Urgente":
                            priorityClass = "priority-urgent";
                            break;
                    }

                    const withoutCleanerIcon = props.semLimpador
                        ? `
                    <i class="bi bi-person-exclamation text-danger ms-1"
                       title="Sem limpador atribuído">
                    </i>
                  `
                        : "";

                    const hora = info.event.start.toLocaleTimeString("pt-PT", {
                        hour: "2-digit",
                        minute: "2-digit"
                    });

                    const main =
                        info.el.querySelector(".fc-event-title") ||
                        info.el.querySelector(".fc-event-main") ||
                        info.el;

                    main.innerHTML = `
                <div class="calendar-event-custom">

                    <div class="priority-indicator ${priorityClass}"></div>

                    <div class="event-content">

                        <div class="event-time">
                            ${hora}
                        </div>

                        <div class="event-title-line">
                            ${icon}

                            <span class="event-property-name">
                                ${info.event.title}
                            </span>

                            ${withoutCleanerIcon}
                        </div>

                    </div>

                </div>
            `;
                },

        eventClick: function (info) {
        const props = info.event.extendedProps;
        const taskId = info.event.id;

        const propertyElement =
        document.getElementById("detailsProperty");

        const cleanerElement =
        document.getElementById("detailsCleaner");

        const cleanerCodeElement =
        document.getElementById("detailsCleanerCode");

        const priorityElement =
        document.getElementById("detailsPriority");

        const statusElement =
        document.getElementById("detailsStatus");

        const dateElement =
        document.getElementById("detailsDate");

        const cleanerPhoneElement =
        document.getElementById("detailsCleanerPhone");

        const contactActions =
        document.getElementById("detailsContactActions");

        const callButton =
        document.getElementById("detailsCallBtn");

        const whatsappButton =
        document.getElementById("detailsWhatsappBtn");

        if (propertyElement) {
        propertyElement.innerText =
        info.event.title;
        }

        if (cleanerElement) {
        cleanerElement.innerText =
        props.funcionaria || "Não atribuído";
        }

        if (cleanerCodeElement) {
        cleanerCodeElement.innerText =
        props.codigoLimpador || "";
        }

        if (priorityElement) {
        priorityElement.innerText =
        props.prioridade || "Não definida";
        }

        if (statusElement) {
        statusElement.innerText =
        props.estado || "Não definido";
        }

        if (dateElement) {
        dateElement.innerText =
        info.event.start
        ? info.event.start.toLocaleString("pt-PT")
        : "Data não disponível";
        }

        const cleanerPhone =
        props.telefone?.toString().trim();

        if (
        cleanerPhone &&
        cleanerPhoneElement &&
        contactActions &&
        callButton &&
        whatsappButton
        ) {
        cleanerPhoneElement.innerText =
        cleanerPhone;

        const phoneForLink =
        cleanerPhone.replace(/[^\d+]/g, "");

        const phoneForWhatsapp =
        cleanerPhone.replace(/\D/g, "");

        callButton.href =
        "tel:" + phoneForLink;

        whatsappButton.href =
        "https://wa.me/" + phoneForWhatsapp;

        contactActions.classList.remove("d-none");
        contactActions.classList.add("d-flex");
        } else {
        if (cleanerPhoneElement) {
        cleanerPhoneElement.innerText =
        "Não disponível";
        }

        if (contactActions) {
        contactActions.classList.remove("d-flex");
        contactActions.classList.add("d-none");
        }

        if (callButton) {
        callButton.removeAttribute("href");
        }

        if (whatsappButton) {
        whatsappButton.removeAttribute("href");
        }
        }

        const detailsFullBtn =
        document.getElementById("detailsFullBtn");

        const assignCleanerBtn =
        document.getElementById("assignCleanerBtn");

        const detailsEditBtn =
        document.getElementById("detailsEditBtn");

        const detailsDeleteBtn =
        document.getElementById("detailsDeleteBtn");

        if (detailsFullBtn) {
        detailsFullBtn.href =
        "/CleaningTask/Details?id=" +
        encodeURIComponent(taskId);
        }

        if (assignCleanerBtn) {
        assignCleanerBtn.href =
        "/CleaningTask/AssignCleaner?id=" +
        encodeURIComponent(taskId);
        }

        if (detailsEditBtn) {
        detailsEditBtn.href =
        "/CleaningTask/Edit?id=" +
        encodeURIComponent(taskId);
        }

        if (detailsDeleteBtn) {
        detailsDeleteBtn.href =
        "/CleaningTask/Delete?id=" +
        encodeURIComponent(taskId);
        }

        if (detailsModal) {
        detailsModal.show();
        }
        }
        });

        if (taskTimeInput) {
        taskTimeInput.addEventListener("change", function () {
        if (scheduledDateInput && scheduledDateInput.value) {
        const dateOnly = scheduledDateInput.value.split("T")[0];
        scheduledDateInput.value = dateOnly + "T" + taskTimeInput.value;
        }
        });
        }

        calendar.render();

        statusFilter.addEventListener("change", function() {
            console.log("Selecionado agora:", this.value);

            calendar.refetchEvents();
        });

        });
    </script>
}

    
