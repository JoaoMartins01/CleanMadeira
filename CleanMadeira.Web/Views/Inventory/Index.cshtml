@model CleanMadeira.Web.ViewModels.Inventory.InventoryIndexVM

@{
    ViewData["Title"] = "Inventário";

    var produtos = Model.Produtos;

    var propriedades = produtos
        .GroupBy(p => new
        {
            p.PropriedadeId,
            p.PropriedadeNome
        })
        .OrderBy(g => g.Key.PropriedadeNome)
        .ToList();
}

<div class="container-fluid py-4">

    <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-box-seam me-2"></i>
                Inventário
            </h1>

            <p class="text-muted mb-0">
                Produtos organizados por propriedade
            </p>
        </div>

        <a asp-controller="Inventory"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Adicionar produto
        </a>
    </div>

    <form asp-action="Index" method="get">
        <select asp-for="PropriedadeSelecionadaId"
                asp-items="Model.Propriedades"
                class="form-select"
                onchange="this.form.submit()">
        </select>
    </form>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (!produtos.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-box-seam display-4 text-muted"></i>

                <h2 class="h5 fw-semibold mt-3">
                    Ainda não existem produtos
                </h2>

                <p class="text-muted">
                    Adiciona o primeiro produto ao inventário.
                </p>

                <a asp-controller="Inventory"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Adicionar produto
                </a>

            </div>
        </div>
    }
    else
    {
        @foreach (var propriedade in propriedades)
        {
            var produtosDaPropriedade = propriedade.ToList();

            var produtosComStockBaixo = produtosDaPropriedade.Count(p =>
                p.Quantidade <= p.QuantidadeMinima);

            <section class="card border-0 shadow-sm mb-4">

                <div class="card-header bg-white border-0 py-3">

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between align-items-sm-center
                                gap-2">

                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                <i class="bi bi-house-door me-2"></i>
                                @propriedade.Key.PropriedadeNome
                            </h2>

                            <span class="text-muted small">
                                @produtosDaPropriedade.Count
                                @(produtosDaPropriedade.Count == 1
                                    ? "produto"
                                    : "produtos")
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            @if (produtosComStockBaixo > 0)
                            {
                                <span class="badge bg-warning text-dark
                                             d-flex align-items-center">

                                    <i class="bi bi-exclamation-triangle me-1"></i>

                                    @produtosComStockBaixo com stock baixo
                                </span>
                            }

                            <a asp-controller="Inventory"
                               asp-action="Create"
                               asp-route-propriedadeId="@propriedade.Key.PropriedadeId"
                               class="btn btn-sm btn-outline-primary">

                                <i class="bi bi-plus-lg me-1"></i>
                                Adicionar
                            </a>

                        </div>
                    </div>

                </div>

                <!-- Desktop e tablet -->
                <div class="table-responsive d-none d-md-block">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Produto</th>
                                <th>Quantidade</th>
                                <th>Unidade</th>
                                <th>Stock mínimo</th>
                                <th>Estado</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in produtosDaPropriedade)
                            {
                                var stockBaixo =
                                    item.Quantidade <= item.QuantidadeMinima;

                                <tr>
                                    <td class="fw-semibold">
                                        @item.Nome
                                    </td>

                                    <td>
                                        @item.Quantidade
                                    </td>

                                    <td>
                                        @item.Unidade
                                    </td>

                                    <td>
                                        @item.QuantidadeMinima
                                    </td>

                                    <td>
                                        @if (stockBaixo)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Stock baixo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Disponível
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-controller="Inventory"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar">

                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-controller="Inventory"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Detalhes">

                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <form asp-controller="Inventory"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Tens a certeza que pretendes eliminar este produto?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Eliminar">

                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <!-- Mobile -->
                <div class="d-md-none p-3">

                    <div class="row g-3">

                        @foreach (var item in produtosDaPropriedade)
                        {
                            var stockBaixo =
                                item.Quantidade <= item.QuantidadeMinima;

                            <div class="col-12">

                                <article class="border rounded-3 p-3">

                                    <div class="d-flex
                                                justify-content-between
                                                align-items-start
                                                gap-3 mb-3">

                                        <div>
                                            <h3 class="h6 fw-bold mb-1">
                                                @item.Nome
                                            </h3>

                                            <span class="text-muted small">
                                                @item.Quantidade @item.Unidade
                                            </span>
                                        </div>

                                        @if (stockBaixo)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Stock baixo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Disponível
                                            </span>
                                        }

                                    </div>

                                    <div class="row g-2 small mb-3">

                                        <div class="col-6">
                                            <div class="text-muted">
                                                Quantidade
                                            </div>

                                            <div class="fw-semibold">
                                                @item.Quantidade
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="text-muted">
                                                Stock mínimo
                                            </div>

                                            <div class="fw-semibold">
                                                @item.QuantidadeMinima
                                            </div>
                                        </div>

                                    </div>

                                    <div class="d-grid d-sm-flex gap-2">

                                        <a asp-controller="Inventory"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil me-1"></i>
                                            Editar
                                        </a>

                                        <a asp-controller="Inventory"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">

                                            <i class="bi bi-eye me-1"></i>
                                            Ver
                                        </a>

                                        <form asp-controller="Inventory"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Tens a certeza que pretendes eliminar este produto?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger w-100">

                                                <i class="bi bi-trash me-1"></i>
                                                Eliminar
                                            </button>

                                        </form>

                                    </div>

                                </article>

                            </div>
                        }

                    </div>

                </div>

            </section>
        }
    }

</div>