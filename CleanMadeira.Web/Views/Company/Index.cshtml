@using CleanMadeira.Web.ViewModels.Empresa
@model IEnumerable<EmpresaVM>

@{
    ViewData["Title"] = "Empresas";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Empresas</h2>

    <a asp-action="Create"
       class="btn btn-primary">

        Nova Empresa

    </a>

</div>

<div class="card">

    <div class="card-body">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Nome</th>
                    <th>NIF</th>
                    <th>Email</th>
                    <th>Telefone</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>

                @foreach (var company in Model)
                {
                    <tr>

                        <td>@company.Nome</td>
                        <td>@company.Nif</td>
                        <td>@company.Email</td>
                        <td>@company.Telefone</td>

                        <td>
                            @if (company.Active)
                            {
                                <span class="badge bg-success">
                                    Ativa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Inativa
                                </span>
                            }
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@company.Id"
                               class="btn btn-sm btn-info">

                                Ver

                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@company.Id"
                               class="btn btn-sm btn-warning">

                                Editar

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>