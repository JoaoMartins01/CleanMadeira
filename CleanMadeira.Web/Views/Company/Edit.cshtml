@using CleanMadeira.Web.ViewModels.Company
@model EditCompanyVM

@{
    ViewData["Title"] = "Editar empresa";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <!-- Cabeçalho -->
            <div class="mb-4">

                <a asp-action="Index"
                   class="text-decoration-none small">

                    <i class="bi bi-arrow-left me-1"></i>
                    Voltar à empresa
                </a>

                <h1 class="h3 fw-bold mt-3 mb-1">
                    <i class="bi bi-building-gear me-2"></i>
                    Editar empresa
                </h1>

                <p class="text-muted mb-0">
                    Atualize os dados da sua empresa.
                </p>

            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                </div>
            }

            <div class="card border-0 shadow-sm">

                <div class="card-body p-3 p-md-4">

                    <form asp-controller="Company"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- Dados -->
                        <div class="mb-4">

                            <h5 class="fw-semibold mb-3">
                                <i class="bi bi-building me-2 text-primary"></i>
                                Dados da empresa
                            </h5>

                            <div class="row g-3">

                                <div class="col-12">

                                    <label asp-for="Name"
                                           class="form-label fw-semibold">
                                    </label>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Nome da empresa" />

                                    <span asp-validation-for="Name"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-6">

                                    <label asp-for="Nif"
                                           class="form-label fw-semibold">
                                    </label>

                                    <input asp-for="Nif"
                                           class="form-control"
                                           inputmode="numeric" />

                                    <span asp-validation-for="Nif"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- Contactos -->
                        <div class="mb-4">

                            <h5 class="fw-semibold mb-3">
                                <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                                Contactos
                            </h5>

                            <div class="row g-3">

                                <div class="col-12 col-md-6">

                                    <label asp-for="Email"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-envelope"></i>
                                        </span>

                                        <input asp-for="Email"
                                               class="form-control" />

                                    </div>

                                    <span asp-validation-for="Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-6">

                                    <label asp-for="Phone"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-telephone"></i>
                                        </span>

                                        <input asp-for="Phone"
                                               class="form-control"
                                               inputmode="tel" />

                                    </div>

                                    <span asp-validation-for="Phone"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- Botões -->
                        <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary order-2 order-sm-1">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary order-1 order-sm-2">

                                <i class="bi bi-check-lg me-1"></i>
                                Guardar alterações
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}