@model CleanMadeira.Web.ViewModels.Company.InviteManagerVM

@{
    ViewData["Title"] = "Adicionar Gestor";
}

<div class="container py-4">

    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        gap-3 mb-4">

        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-person-plus me-2"></i>
                Adicionar Gestor
            </h1>

            <p class="text-muted mb-0">
                Convide um utilizador para gerir
                @Model.CompanyName.
            </p>
        </div>

        <a asp-controller="Company"
           asp-action="Details"
           asp-route-id="@Model.CompanyId"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Voltar
        </a>

    </div>


    <div class="row justify-content-center">

        <div class="col-12 col-lg-7 col-xl-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="rounded-3
                            bg-primary-subtle
                            text-primary
                            d-flex
                            align-items-center
                            justify-content-center"
                             style="width:48px;height:48px;">

                            <i class="bi bi-envelope-plus fs-4"></i>

                        </div>

                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Enviar convite
                            </h2>

                            <p class="text-muted small mb-0">
                                O gestor receberá um convite por email.
                            </p>
                        </div>

                    </div>


                    <form asp-controller="Company"
                          asp-action="InviteManager"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="CompanyId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">
                                Email do gestor
                            </label>

                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="gestor@email.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Introduza o email da pessoa que pretende
                                adicionar à equipa de gestão.
                            </div>

                        </div>


                        <div class="alert alert-light border mb-4">

                            <div class="d-flex gap-2">

                                <i class="bi bi-info-circle
                                text-primary mt-1"></i>

                                <div class="small">

                                    <strong>Como funciona?</strong>

                                    <div class="text-muted mt-1">
                                        Se o utilizador já tiver conta,
                                        poderá aceitar o convite e juntar-se
                                        à empresa. Caso ainda não tenha conta,
                                        poderá criar uma através do convite.
                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="d-flex
                            flex-column
                            flex-sm-row
                            gap-2">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-send me-1"></i>
                                Enviar convite

                            </button>

                            <a asp-controller="Company"
                               asp-action="Details"
                               asp-route-id="@Model.CompanyId"
                               class="btn btn-outline-secondary">

                                Cancelar

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}