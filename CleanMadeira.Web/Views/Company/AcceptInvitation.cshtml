@model CleanMadeira.Web.ViewModels.Company.AcceptInvitationVM

@{
    ViewData["Title"] = "Convite para Empresa";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4 p-md-5 text-center">

                    <!-- ÍCONE -->
                    <div class="d-flex
                        align-items-center
                        justify-content-center
                        mx-auto mb-4
                        rounded-circle
                        bg-primary-subtle
                        text-primary"
                         style="width:72px;height:72px;">

                        <i class="bi bi-building-add fs-2"></i>

                    </div>


                    <!-- TÍTULO -->
                    <h1 class="h3 fw-bold mb-2">
                        Convite para empresa
                    </h1>

                    <p class="text-muted mb-4">
                        Foi convidado para integrar a equipa
                        de gestão de
                    </p>


                    <!-- EMPRESA -->
                    <div class="border rounded-3 p-3 mb-4">

                        <div class="d-flex
                            align-items-center
                            justify-content-center
                            gap-2">

                            <i class="bi bi-buildings
                            text-primary fs-5"></i>

                            <span class="fw-bold fs-5">
                                @Model.CompanyName
                            </span>

                        </div>

                    </div>


                    <!-- INFORMAÇÃO -->
                    <div class="text-start bg-light
                        rounded-3 p-3 mb-4">

                        <div class="mb-3">

                            <small class="text-muted d-block">
                                Convite enviado para
                            </small>

                            <span class="fw-semibold">
                                @Model.Email
                            </span>

                        </div>

                        <div>

                            <small class="text-muted d-block">
                                Válido até
                            </small>

                            <span class="fw-semibold">
                                @Model.ExpiresAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </span>

                        </div>

                    </div>


                    <p class="text-muted small mb-4">
                        Ao aceitar, terá acesso às propriedades
                        e funcionalidades disponibilizadas
                        aos gestores desta empresa.
                    </p>


                    <!-- ACEITAR -->
                    <form asp-controller="Company"
                          asp-action="ConfirmInvitation"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Token" />

                        <button type="submit"
                                class="btn btn-primary
                            btn-lg w-100">

                            <i class="bi bi-check-lg me-1"></i>
                            Aceitar convite

                        </button>

                    </form>


                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="btn btn-link
                        text-muted
                        text-decoration-none mt-2">

                        Agora não

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>