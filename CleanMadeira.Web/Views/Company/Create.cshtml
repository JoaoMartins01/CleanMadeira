@using CleanMadeira.Web.ViewModels.Company
@model CreateCompanyVM

@{
    ViewData["Title"] = "Criar empresa";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <!-- Cabeçalho -->
            <div class="mb-4">
                <h1 class="h3 fw-bold mb-1">
                    <i class="bi bi-building-add me-2"></i>
                    Criar empresa
                </h1>

                <p class="text-muted mb-0">
                    Preencha os dados da sua empresa para começar a utilizar o CleanMadeira.
                </p>
            </div>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-3 p-md-4">

                    <form asp-controller="Company"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <!-- Dados principais -->
                        <div class="mb-4">

                            <h5 class="fw-semibold mb-3">
                                <i class="bi bi-building me-2 text-primary"></i>
                                Dados da empresa
                            </h5>

                            <div class="row g-3">

                                <div class="col-12">
                                    <label asp-for="Name"
                                           class="form-label fw-semibold">
                                    </label>

                                    <input asp-for="Name"
                                           class="form-control"
                                           placeholder="Ex.: Madeira Clean" />

                                    <span asp-validation-for="Name"
                                          class="text-danger small">
                                    </span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Nif"
                                           class="form-label fw-semibold">
                                    </label>

                                    <input asp-for="Nif"
                                           class="form-control"
                                           placeholder="Ex.: 500000000"
                                           inputmode="numeric" />

                                    <span asp-validation-for="Nif"
                                          class="text-danger small">
                                    </span>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="Type"
                                           class="form-label fw-semibold">
                                    </label>

                                    <select asp-for="Type" class="form-select">
                                        <option value="">
                                            Selecione o tipo de empresa
                                        </option>
                                        <option value="1">
                                            Alojamento Local
                                        </option>
                                        <option value="2">
                                            Limpeza
                                        </option>

                                    </select>

                                    <span asp-validation-for="Type"
                                          class="text-danger small">
                                    </span>
                                </div>

                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- Contactos -->
                        <div class="mb-4">

                            <h5 class="fw-semibold mb-3">
                                <i class="bi bi-person-lines-fill me-2 text-primary"></i>
                                Contactos
                            </h5>

                            <div class="row g-3">

                                <div class="col-12 col-md-6">

                                    <label asp-for="Email"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-envelope"></i>
                                        </span>

                                        <input asp-for="Email"
                                               class="form-control"
                                               placeholder="empresa@exemplo.pt" />

                                    </div>

                                    <span asp-validation-for="Email"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-6">

                                    <label asp-for="Phone"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-telephone"></i>
                                        </span>

                                        <input asp-for="Phone"
                                               class="form-control"
                                               placeholder="912 345 678"
                                               inputmode="tel" />

                                    </div>

                                    <span asp-validation-for="Phone"
                                          class="text-danger small">
                                    </span>

                                </div>

                                <div class="col-12 col-md-6">

                                    <label asp-for="Endereço"
                                           class="form-label fw-semibold">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            <i class="bi bi-telephone"></i>
                                        </span>

                                        <input asp-for="Endereço"
                                               class="form-control"
                                               placeholder="912 345 678"
                                               inputmode="tel" />

                                    </div>

                                    <span asp-validation-for="Endereço"
                                          class="text-danger small">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- Informação -->
                        <div class="alert alert-light border d-flex gap-3 mb-4">

                            <i class="bi bi-info-circle-fill text-primary fs-4"></i>

                            <div>
                                <div class="fw-semibold">
                                    Validação da empresa
                                </div>

                                <div class="small text-muted">
                                    Após criar a empresa, os dados ficarão
                                    pendentes de validação antes de todas as
                                    funcionalidades ficarem disponíveis.
                                </div>
                            </div>

                        </div>

                        <!-- Botões -->
                        <div class="d-flex flex-column flex-sm-row
                            justify-content-end gap-2">

                            <a asp-controller="Dashboard"
                               asp-action="Index"
                               class="btn btn-outline-secondary order-2 order-sm-1">

                                <i class="bi bi-x-lg me-1"></i>
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary order-1 order-sm-2">

                                <i class="bi bi-check-lg me-1"></i>
                                Criar empresa
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}