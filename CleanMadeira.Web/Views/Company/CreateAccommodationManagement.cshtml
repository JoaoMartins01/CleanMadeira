@using CleanMadeira.Web.ViewModels.Company
@model CreateAccommodationManagementCompanyVM

@{
    ViewData["Title"] = "Criar Empresa";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">
            <i class="bi bi-buildings me-2"></i>
            Criar Empresa
        </h1>

        <p class="text-muted mb-0">
            Introduza os dados da empresa de gestão de alojamento local.
        </p>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body p-4">

            <form asp-action="CreateAccommodationManagement"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-12">
                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Nome da empresa
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Ex.: Madeira Homes" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="NIF"
                               class="form-label fw-semibold">
                            NIF
                        </label>

                        <input asp-for="NIF"
                               class="form-control"
                               placeholder="Ex.: 510000000" />

                        <span asp-validation-for="NIF"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Phone"
                               class="form-label fw-semibold">
                            Telefone
                        </label>

                        <input asp-for="Phone"
                               type="tel"
                               class="form-control"
                               placeholder="Ex.: +351 291 000 000" />

                        <span asp-validation-for="Phone"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email"
                               class="form-label fw-semibold">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="empresa@email.pt" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address"
                               class="form-label fw-semibold">
                            Morada
                        </label>

                        <input asp-for="Address"
                               class="form-control"
                               placeholder="Rua, número, localidade..." />

                        <span asp-validation-for="Address"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Criar empresa
                    </button>

                    <a asp-action="MyCompany"
                       class="btn btn-outline-secondary">

                        Cancelar
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>