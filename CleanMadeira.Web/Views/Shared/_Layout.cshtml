@using CleanMadeira.Domain.Entities
@using CleanMadeira.Domain.Entities.Enums
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userName = currentUser != null
        ? $"{currentUser.PrimeiroNome} {currentUser.UltimoNome}"
        : "Utilizador";

    var isCleaner = currentUser?.Role == UserRole.Limpador;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - CleanMadeira</title>

    <link rel="manifest" href="@Url.Content("~/manifest.json")" />
    <meta name="theme-color" content="#0d47a1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>

<body>

    <div class="app-wrapper">

        <aside id="sidebar" class="sidebar">

            <div class="sidebar-logo">
                <img src="~/images/logo.png" alt="CleanMadeira" />
                <h4>CleanMadeira</h4>
                <small>Limpeza • Organização • Confiança</small>
            </div>

            <nav class="sidebar-menu">

                @if (isCleaner)
                {
                    <a asp-controller="CleaningTask"
                       asp-action="MyTasks"
                       class="sidebar-link">
                        <i class="bi bi-check2-square"></i>
                        <span>Minhas Limpezas</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="Propriedade"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-buildings"></i>
                        <span>Propriedades</span>
                    </a>

                    <a asp-controller="CleaningTask"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        <span>Limpezas</span>
                    </a>

                    <a asp-controller="Inventory"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-box-seam"></i>
                        <span>Inventário</span>
                    </a>

                    <a asp-controller="Maintenance"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-tools"></i>
                        <span>Manutenção</span>
                    </a>
                }

            </nav>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="sidebar-logout">
                @Html.AntiForgeryToken()

                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Terminar sessão</span>
                </button>
            </form>

        </aside>

        <div class="main-area">

            <header class="topbar">

                <button id="sidebarToggle"
                        type="button"
                        class="menu-btn">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-brand">
                    <img src="~/images/logo.png" alt="CleanMadeira" />
                    <span>CleanMadeira</span>
                </div>

                <div class="topbar-user">
                    <div class="user-info">
                        <strong>@userName</strong>
                        <small>@(isCleaner ? "Limpador" : "Gestor AL")</small>
                    </div>

                    <div class="dropdown">
                        <button class="btn user-menu-button dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-person-circle me-2"></i>

                            <span class="d-none d-md-inline">
                                @User.Identity?.Name
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                            <li>
                                <a asp-controller="Account"
                                   asp-action="Perfil"
                                   class="dropdown-item">
                                    <i class="bi bi-person-fill me-2"></i>
                                    O meu perfil
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Account"
                                   asp-action="ChangePassword"
                                   class="dropdown-item">
                                    <i class="bi bi-key-fill me-2"></i>
                                    Alterar palavra-passe
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Terminar sessão
                                    </button>
                                </form>
                            </li>

                        </ul>
                    </div>
                </div>

            </header>

            <div class="container-fluid mt-3">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["Success"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["Warning"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

            </div>

            <main class="content-area">
                <div class="content-card">
                    @RenderBody()
                </div>
            </main>

            <footer class="app-footer">
                © @DateTime.Now.Year CleanMadeira. Todos os direitos reservados.
            </footer>

        </div>

    </div>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    <script src="~/js/layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker.js");
        }
    </script>
</body>
</html>