@using CleanMadeira.Domain.Entities
@using CleanMadeira.Domain.Enums
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = await UserManager.GetUserAsync(User);
    var userName = currentUser != null
        ? $"{currentUser.PrimeiroNome} {currentUser.UltimoNome}"
        : "Utilizador";

    var isOwner = currentUser?.Role == UserRole.Dono;
    var isCleaner = currentUser?.Role == UserRole.Limpador;
    var isCleanerAndManager = currentUser?.Role == UserRole.GestorELimpador;

    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var maintenanceMenuOpen =
        currentController == "Maintenance" ||
        currentController == "MaintenanceReport" ||
        currentController == "MaintenanceProvider";
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - CleanMadeira</title>

    <link rel="manifest" href="@Url.Content("~/manifest.json")" />
    <meta name="theme-color" content="#0d47a1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />
    
    <link rel="icon" type="image/png" href="~/images/favicon.png" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    
        

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="app-wrapper">

        <aside id="sidebar" class="sidebar">

            <div class="sidebar-logo">
                <img src="~/images/logo.png" alt="CleanMadeira" />
                <h4>CleanMadeira</h4>
                <small>Limpeza • Organização • Confiança</small>
            </div>

            <nav class="sidebar-menu">

                @if (isCleaner)
                {
                    <a asp-controller="CleaningTask"
                       asp-action="MyTasks"
                       class="sidebar-link">
                        <i class="bi bi-check2-square"></i>
                        <span>Minhas Limpezas</span>
                    </a>
                }

                @if (isCleanerAndManager)
                {
                    <a asp-controller="CleaningTask"
                       asp-action="MyTasks"
                       class="sidebar-link">
                        <i class="bi bi-check2-square"></i>
                        <span>Minhas Limpezas</span>
                    </a>

                    <a asp-controller="CleaningTask"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        <span>Limpezas</span>
                    </a>

                    <a asp-controller="Team"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-check2-square"></i>
                        <span>Equipa</span>
                    </a>
                }

                @if(isOwner)
                {
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Dashboard</span>
                    </a>

                    <a asp-controller="Company"
                       asp-action="MyCompany"
                       class="nav-link sidebar-link">

                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-buildings nav-icon"></i>
                            <span>Empresa</span>
                        </span>

                    </a>

                    <a asp-controller="Propriedade"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-buildings"></i>
                        <span>Propriedades</span>
                    </a>

                    <a asp-controller="CleaningTask"
                       asp-action="Index"
                       class="sidebar-link">
                        <i class="bi bi-calendar-check"></i>
                        <span>Limpezas</span>
                    </a>

                    <a asp-controller="Inventory"
                       asp-action="Index"
                       class="nav-link sidebar-link">

                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam nav-icon"></i>
                            <span>Inventário</span>
                        </span>

                    </a>


                    <button type="button"
                            class="nav-link maintenance-menu-toggle
                        @(maintenanceMenuOpen ? "active" : "")"
                            data-bs-toggle="collapse"
                            data-bs-target="#maintenanceSubmenu"
                            aria-expanded="@maintenanceMenuOpen.ToString().ToLower()"
                            aria-controls="maintenanceSubmenu">

                        <span class="d-flex align-items-center">
                            <i class="bi bi-tools nav-icon"></i>
                            <span>Manutenções</span>
                        </span>

                        <i class="bi bi-chevron-down maintenance-chevron"></i>

                    </button>


                    <div id="maintenanceSubmenu"
                         class="collapse @(maintenanceMenuOpen ? "show" : "")">

                        <div class="maintenance-submenu">

                            <a asp-controller="MaintenanceReport"
                               asp-action="Index"
                               class="maintenance-submenu-link
                                @(currentController == "MaintenanceReport"
                                   ? "active"
                                   : "")">

                                <i class="bi bi-exclamation-triangle"></i>
                                <span>Reportes</span>
                            </a>

                            <a asp-controller="Maintenance"
                               asp-action="Index"
                               class="maintenance-submenu-link
                                @(currentController == "Maintenance"
                                   ? "active"
                                   : "")">

                                <i class="bi bi-wrench-adjustable"></i>
                                <span>Manutenções</span>
                            </a>

                            <a asp-controller="MaintenanceProvider"
                               asp-action="Index"
                               class="maintenance-submenu-link
                                @(currentController == "MaintenanceProvider"
                                   ? "active"
                                   : "")">

                                <i class="bi bi-person-workspace"></i>
                                <span>Prestadores</span>
                            </a>

                        </div>

                    </div>


                    <a asp-controller="Report"
                       asp-action="Index"
                       class="nav-link sidebar-link">

                        <span class="d-flex align-items-center gap-2">
                            <i class="bi bi-bar-chart-line nav-icon"></i>
                            <span>Relatórios</span>
                        </span>

                    </a>

                    
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a asp-controller="AdminCompany"
                           asp-action="Index"
                           class="nav-link">

                            <i class="bi bi-building-check me-2"></i>
                            Empresas pendentes

                        </a>
                    </li>
                }

            </nav>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="sidebar-logout">
                @Html.AntiForgeryToken()

                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Terminar sessão</span>
                </button>
            </form>

        </aside>

        <div class="main-area">

            <header class="topbar">

                <button id="sidebarToggle"
                        type="button"
                        class="menu-btn">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-brand">
                    <img src="~/images/logo.png" alt="CleanMadeira" />
                    <span>CleanMadeira</span>
                </div>

                <div class="topbar-user">
                    <div class="user-info">
                        <strong>@userName</strong>
                        <small>@(isCleaner ? "Limpador" : "Gestor AL")</small>
                    </div>

                    <div class="dropdown">
                        <button class="btn user-menu-button dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-person-circle me-2"></i>

                            <span class="d-none d-md-inline">
                                @User.Identity?.Name
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                            <li>
                                <a asp-controller="Account"
                                   asp-action="Perfil"
                                   class="dropdown-item">
                                    <i class="bi bi-person-fill me-2"></i>
                                    O meu perfil
                                </a>
                            </li>

                            <li>
                                <a asp-controller="Account"
                                   asp-action="ChangePassword"
                                   class="dropdown-item">
                                    <i class="bi bi-key-fill me-2"></i>
                                    Alterar palavra-passe
                                </a>
                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Terminar sessão
                                    </button>
                                </form>
                            </li>

                        </ul>
                    </div>
                </div>

            </header>

            <div class="container-fluid mt-3">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        @TempData["Success"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TempData["Warning"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>
                    </div>
                }

            </div>

            <main class="content-area">
                <div class="content-card">
                    @RenderBody()
                </div>
            </main>

            <footer class="app-footer">
                © @DateTime.Now.Year CleanMadeira. Todos os direitos reservados.
            </footer>

        </div>

    </div>

    <div class="modal fade"
         id="confirmDeleteModal"
         tabindex="-1"
         aria-labelledby="confirmDeleteModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="confirmDeleteModalLabel">

                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                        Confirmar eliminação

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Fechar">
                    </button>

                </div>

                <div class="modal-body">

                    <p id="confirmDeleteMessage"
                       class="mb-0">

                        Tem a certeza que pretende eliminar este item?

                    </p>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancelar

                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            id="confirmDeleteButton">

                        <i class="bi bi-trash me-1"></i>
                        Eliminar

                    </button>

                </div>

            </div>

        </div>

    </div>

    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
                document.addEventListener("DOMContentLoaded", function () {

                    const modalElement =
                        document.getElementById("confirmDeleteModal");

                    const confirmButton =
                document.getElementById("confirmDeleteButton");

            const messageElement =
                    document.getElementById("confirmDeleteMessage");

                    if (!modalElement ||
                        !confirmButton ||
                        !messageElement) {
                        return;
                    }

                    const modal =
                        new bootstrap.Modal(modalElement);

                    let formToSubmit = null;

                    document.querySelectorAll("[data-confirm-delete]")
                        .forEach(button => {

                            button.addEventListener("click", function (event) {

                                event.preventDefault();

                                formToSubmit =
                                    button.closest("form");

                                const message =
                                    button.dataset.confirmMessage ??
                                    "Tem a certeza que pretende eliminar este item?";

                                messageElement.textContent =
                                    message;

                                modal.show();
                            });

                        });

                    confirmButton.addEventListener("click", function () {

                        if (!formToSubmit) {
                            return;
                        }

                        modal.hide();

                        formToSubmit.submit();
                    });

                });
    </script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
    </script>

    <script src="~/js/layout.js" asp-append-version="true"></script>

    <script src="~/js/local-time.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        if ("serviceWorker" in navigator) {
        navigator.serviceWorker.register("/service-worker.js");
        }
    </script>
</body>
</html>