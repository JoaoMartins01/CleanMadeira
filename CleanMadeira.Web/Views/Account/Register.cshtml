@using CleanMadeira.Domain.Entities
@using CleanMadeira.Domain.Entities.Enums
@using CleanMadeira.Web.ViewModels.Account
@model RegisterVM

@{
    ViewData["Title"] = "Criar Conta";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>CleanMadeira - Criar Conta</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/css/intlTelInput.css" rel="stylesheet">

    <style>
            body {
                min-height: 100vh;
                background: linear-gradient(135deg, #0d47a1, #1976d2);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px;
            }

            .register-card {
                width: 100%;
                max-width: 860px;
                border: 0;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 20px 50px rgba(0,0,0,.22);
            }

            .brand-panel {
                background: #0d47a1;
                color: white;
                padding: 40px;
            }

                .brand-panel img {
                    width: 90px;
                    background: white;
                    border-radius: 18px;
                    padding: 8px;
                    margin-bottom: 18px;
                }

            .form-panel {
                background: white;
                padding: 40px;
            }
    </style>
</head>

<body>

    <div class="card register-card">
        <div class="row g-0">

            <div class="col-md-5 brand-panel">
                <img src="~/images/logo.png" alt="CleanMadeira" />

                <h2 class="fw-bold">CleanMadeira</h2>

                <p class="mt-3">
                    Gestão simples de limpezas, propriedades e inventário para alojamentos locais.
                </p>

                <div class="mt-4 small">
                    <p><i class="bi bi-check-circle-fill me-2"></i> Calendário de limpezas</p>
                    <p><i class="bi bi-check-circle-fill me-2"></i> Gestão de stock</p>
                    <p><i class="bi bi-check-circle-fill me-2"></i> Área para limpadores</p>
                </div>
            </div>

            <div class="col-md-7 form-panel">

                <h3 class="fw-bold mb-1">Criar conta</h3>
                <p class="text-muted mb-4">Preencha os dados para começar.</p>

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrimeiroNome" class="form-label"></label>
                            <input asp-for="PrimeiroNome" class="form-control" />
                            <span asp-validation-for="PrimeiroNome" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UltimoNome" class="form-label"></label>
                            <input asp-for="UltimoNome" class="form-control" />
                            <span asp-validation-for="UltimoNome" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telemovel" class="form-label">Telefone</label>

                        <input asp-for="Telemovel"
                               id="phone"
                               class="form-control"
                               type="tel" />

                        <span asp-validation-for="Telemovel" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" type="password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label">Tipo de conta</label>

                        <select asp-for="Role" class="form-select" id="roleSelect">
                            <option value="">Selecione...</option>
                            <option value="@((int)UserRole.Dono)">Gestor de Alojamento Local</option>
                            <option value="@((int)UserRole.Limpador)">Limpador</option>
                        </select>

                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>

                    <div id="ownerTypeBox" class="mb-3 d-none">
                        <label asp-for="Type" class="form-label">Tipo de proprietário</label>

                        <select asp-for="Type" class="form-select" id="ownerType">
                            <option value="">Selecione...</option>
                            <option value="1">Pessoa Singular</option>
                            <option value="2">Empresa</option>
                        </select>

                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div id="companyNameBox" class="mb-3 d-none">
                        <label asp-for="EmpresaNome" class="form-label">Nome da empresa</label>
                        <input asp-for="EmpresaNome" class="form-control" id="empresaNome" />
                        <span asp-validation-for="EmpresaNome" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                        <i class="bi bi-person-plus-fill me-2"></i>
                        Criar conta
                    </button>

                    <div class="text-center mt-4">
                        <a asp-controller="Account" asp-action="Login">
                            Já tenho conta
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const roleSelect = document.getElementById("roleSelect");
                const ownerTypeBox = document.getElementById("ownerTypeBox");
                const ownerType = document.getElementById("ownerType");
                const companyNameBox = document.getElementById("companyNameBox");
                const empresaNome = document.getElementById("empresaNome");

                function updateVisibility() {
                    if (roleSelect.value === "@((int)UserRole.Dono)") {
                        ownerTypeBox.classList.remove("d-none");
                    } else {
                        ownerTypeBox.classList.add("d-none");
                        companyNameBox.classList.add("d-none");
                        ownerType.value = "";
                        empresaNome.value = "";
                        return;
                    }

                    if (ownerType.value === "2") {
                        companyNameBox.classList.remove("d-none");
                    } else {
                        companyNameBox.classList.add("d-none");
                        empresaNome.value = "";
                    }
                }

                roleSelect.addEventListener("change", updateVisibility);
                ownerType.addEventListener("change", updateVisibility);

                updateVisibility();
            });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@25.3.1/build/js/intlTelInput.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        const phoneInput = document.querySelector("#phone");
        const form = phoneInput.closest("form");

        const iti = window.intlTelInput(phoneInput, {
        initialCountry: "pt",
        preferredCountries: ["pt", "gb", "es", "fr", "de", "br"],
        separateDialCode: true,
        nationalMode: true
        });

        form.addEventListener("submit", function () {
        let value = phoneInput.value.trim();

        // Se já tem indicativo, não adiciona outra vez
        if (value.startsWith("+")) {
        phoneInput.value = value.replace(/\s/g, "");
        return;
        }

        const countryData = iti.getSelectedCountryData();
        const dialCode = "+" + countryData.dialCode;

        let cleanedNumber = value.replace(/\D/g, "");

        phoneInput.value = dialCode + cleanedNumber;
        });
        });
    </script>

</body>
</html>