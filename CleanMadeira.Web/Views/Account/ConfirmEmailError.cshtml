@{
    ViewData["Title"] = "Não foi possível confirmar";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-5 text-center">

                    <div class="mb-3">
                        <i class="bi bi-exclamation-circle-fill text-danger"
                           style="font-size: 4rem;"></i>
                    </div>

                    <h2 class="mb-3">Não foi possível confirmar a conta</h2>

                    <p class="text-muted mb-4">
                        O link pode estar inválido, já ter sido utilizado
                        ou ter expirado.
                    </p>

                    <div asp-validation-summary="All"
                         class="text-danger mb-3"></div>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-outline-primary w-100">
                        Voltar ao início de sessão
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>