@using CleanMadeira.Web.ViewModels.Account
@model LoginVM

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>CleanMadeira - Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                min-height: 100vh;
                margin: 0;
                background: linear-gradient(135deg, #0d47a1, #1976d2);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                font-family: Arial, sans-serif;
            }

            .login-card {
                width: 100%;
                max-width: 850px;
                border: 0;
                border-radius: 22px;
                overflow: hidden;
                box-shadow: 0 20px 50px rgba(0, 0, 0, .22);
            }

            .brand-panel {
                background: #0d47a1;
                color: white;
                padding: 42px;
            }

                .brand-panel img {
                    width: 90px;
                    height: 90px;
                    object-fit: contain;
                    background: white;
                    border-radius: 18px;
                    padding: 8px;
                    margin-bottom: 18px;
                }

                .brand-panel h2 {
                    margin-bottom: 0;
                }

            .brand-description {
                line-height: 1.6;
            }

            .feature-list p {
                margin-bottom: 12px;
            }

            .form-panel {
                background: white;
                padding: 42px;
            }

            .input-group-text {
                background-color: #f8f9fa;
                min-width: 46px;
                justify-content: center;
            }

            .form-control {
                min-height: 48px;
            }

            .btn-login {
                min-height: 50px;
                border-radius: 10px;
                font-weight: 600;
            }

            /* TABLET / MOBILE */
            @@media (max-width: 767.98px) {

                body {
                    align-items: flex-start;
                    padding: 16px;
                }

                .login-card {
                    max-width: 520px;
                    border-radius: 18px;
                }

                .brand-panel {
                    padding: 24px;
                    text-align: center;
                }

                    .brand-panel img {
                        width: 68px;
                        height: 68px;
                        border-radius: 14px;
                        margin-bottom: 10px;
                    }

                    .brand-panel h2 {
                        font-size: 1.5rem;
                    }

                .brand-description {
                    font-size: .92rem;
                    margin-top: 10px !important;
                    margin-bottom: 0;
                }

                .feature-list {
                    display: none;
                }

                .form-panel {
                    padding: 28px 24px;
                }

                    .form-panel h3 {
                        font-size: 1.5rem;
                    }

                .login-options {
                    flex-direction: column;
                    align-items: flex-start !important;
                    gap: 12px;
                }
            }

            /* TELEMÓVEIS PEQUENOS */
            @@media (max-width: 420px) {

                body {
                    padding: 0;
                    background: white;
                }

                .login-card {
                    min-height: 100vh;
                    border-radius: 0;
                    box-shadow: none;
                }

                .brand-panel {
                    padding: 22px 18px;
                }

                    .brand-panel img {
                        width: 60px;
                        height: 60px;
                    }

                .brand-description {
                    font-size: .88rem;
                }

                .form-panel {
                    padding: 28px 20px 35px;
                }

                .form-control,
                .input-group-text {
                    font-size: 16px;
                }

                .btn-login {
                    font-size: 1rem;
                }

                .register-area {
                    font-size: .92rem;
                }
            }
    </style>
</head>

<body>

    <div class="card login-card">
        <div class="row g-0">

            <!-- PAINEL DA MARCA -->
            <div class="col-md-5 brand-panel">

                <img src="~/images/logo.png"
                     alt="CleanMadeira" />

                <h2 class="fw-bold">
                    CleanMadeira
                </h2>

                <p class="brand-description mt-3">
                    Gestão simples de limpezas, propriedades e inventário
                    para alojamentos locais.
                </p>

                <div class="feature-list mt-4 small">
                    <p>
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Calendário de limpezas
                    </p>

                    <p>
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Inventário por propriedade
                    </p>

                    <p>
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Área para limpadores
                    </p>
                </div>

            </div>

            <!-- FORMULÁRIO -->
            <div class="col-md-7 form-panel">

                <h3 class="fw-bold mb-1">
                    Entrar
                </h3>

                <p class="text-muted mb-4">
                    Aceda à sua conta CleanMadeira.
                </p>

                <form asp-controller="Account"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="ReturnUrl" type="hidden" />

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <!-- EMAIL -->
                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-envelope-fill"></i>
                            </span>

                            <input asp-for="Email"
                                   class="form-control"
                                   autocomplete="email"
                                   placeholder="email@exemplo.com" />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- PASSWORD -->
                    <div class="mb-3">

                        <label asp-for="Password"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                <i class="bi bi-lock-fill"></i>
                            </span>

                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="A sua password" />

                        </div>

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- OPÇÕES -->
                    <div class="login-options d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">

                            <input asp-for="RememberMe"
                                   class="form-check-input" />

                            <label asp-for="RememberMe"
                                   class="form-check-label">
                                Lembrar-me
                            </label>

                        </div>

                        <a asp-controller="Account"
                           asp-action="ForgotPassword"
                           class="text-decoration-none">
                            Esqueceu-se da password?
                        </a>

                    </div>

                    <!-- LOGIN -->
                    <button type="submit"
                            class="btn btn-primary btn-lg w-100 btn-login">

                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Entrar

                    </button>

                    <!-- REGISTO -->
                    <div class="register-area text-center mt-4">

                        <span class="text-muted">
                            Ainda não tem conta?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="fw-semibold text-decoration-none ms-1">
                            Criar conta
                        </a>

                    </div>

                </form>

            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>

