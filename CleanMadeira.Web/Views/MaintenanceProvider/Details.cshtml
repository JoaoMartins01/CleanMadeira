@model CleanMadeira.Web.ViewModels.MaintenanceProvider.MaintenanceProviderVM

@{
    ViewData["Title"] = "Detalhes do Prestador de Manutenção";

    
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-tools"></i>
            Detalhes do Prestador
        </h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Voltar
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.Name)
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.CompanyName)
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.CompanyName) ? "-" : Model.CompanyName)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.Specialty)
                </dt>

                <dd class="col-sm-9">
                    @Model.Specialty
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.PhoneNumber)
                </dt>

                <dd class="col-sm-9">
                    @Model.PhoneNumber
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.Email)
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Email) ? "-" : Model.Email)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.Active)
                </dt>

                <dd class="col-sm-9">
                    @if (Model.Active)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inativo</span>
                    }
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(m => m.Notes)
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Notes) ? "Sem observações." : Model.Notes)
                </dd>

            </dl>

        </div>

        <div class="card-footer">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil"></i>
                Editar
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                <i class="bi bi-trash"></i>
                Eliminar
            </a>

        </div>

    </div>

</div>